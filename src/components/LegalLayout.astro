---
/**
 * LegalLayout: the shared reading layout for /support, /credits, /privacy and /terms. Layout only: the pages'
 * words are their own (privacy and terms are Isak's wording). `effective` shows "Effective: …" (legal pages);
 * `updated` shows "Updated …" (help pages).
 */
interface Props {
  heading: string;
  effective?: string;
  updated?: string;
  eyebrow?: string;
}
const { heading, effective, updated, eyebrow } = Astro.props;
---

<section class="pb-20 pt-28 md:pb-28 md:pt-40">
  <div class="mx-auto max-w-3xl px-5 md:px-6">
    {eyebrow && <p class="t-caption">{eyebrow}</p>}
    <h1 class="t-title1 mt-3">{heading}</h1>
    {effective && <p class="t-foot mt-3">Effective: {effective}</p>}
    {updated && <p class="t-foot mt-3">Updated {updated}</p>}
    <article class="prose-legal mt-10 md:mt-12">
      <slot />
    </article>
  </div>
</section>
