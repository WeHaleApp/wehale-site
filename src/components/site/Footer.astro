---
/**
 * Footer: the stores once, one quiet newsletter line (the live subscribe endpoint, with the privacy wording), and
 * every page including Support, Investors and Credits. "Privacy choices" reopens the consent banner; it shows only
 * when a tag is configured. The partner pages are not listed (DIRECTION.md §5: unlisted).
 */
import StoreButtons from "./StoreButtons.astro";
import { BREATHE_URL } from "./links";
const SUBSCRIBE_URL = "https://wehale-app-production.up.railway.app/marketing/subscribe";
const cols = [
  { h: "WeHale", links: [["Try a session", BREATHE_URL], ["Sessions", "/#sessions"], ["About", "/about"]] },
  { h: "Help", links: [["Support", "/support"], ["support@wehale.io", "mailto:support@wehale.io"], ["Partners and press: hello@wehale.io", "mailto:hello@wehale.io"], ["Investors", "/investors"]] },
  { h: "Legal", links: [["Privacy", "/privacy"], ["Terms", "/terms"], ["Credits", "/credits"]] },
];
---
<footer class="border-t border-[var(--color-line)]" id="get-the-app">
  <div class="mx-auto max-w-6xl px-5 py-14 md:px-6 md:py-20">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="col-span-2 sm:col-span-3 md:col-span-1">
        <img src="/assets/images/logo.svg" alt="WeHale" width="112" height="21" class="h-[21px] w-auto" loading="lazy" />
        <p class="t-body mt-4 max-w-xs">Guided breathing sessions, with a voice to follow. On iPhone and Android.</p>
        <StoreButtons class="mt-6" at="footer" />
        <form class="mt-8 max-w-sm" data-newsletter data-endpoint={SUBSCRIBE_URL} novalidate>
          <label for="nl" class="t-caption">Occasional letters</label>
          <div class="mt-3 flex gap-2">
            <input id="nl" name="email" type="email" autocomplete="email" placeholder="you@example.com" required class="min-h-[48px] w-full min-w-0 rounded-[var(--radius-pill)] bg-[var(--color-glass)] px-4 text-base text-[var(--color-text)] outline-none ring-1 ring-[var(--color-line-strong)] placeholder:text-[var(--color-text-tertiary)] focus:ring-[var(--color-text-secondary)]" />
            <button type="submit" class="btn-quiet shrink-0 !px-5">Subscribe</button>
          </div>
          <p class="t-foot mt-2" data-newsletter-status role="status">A few emails a year. Unsubscribe any time. <a href="/privacy" class="link !font-normal">Privacy</a></p>
        </form>
      </div>
      {cols.map((c) => (
        <div>
          <h2 class="t-caption">{c.h}</h2>
          <ul class="mt-2">
            {c.links.map(([l, h]) => <li><a href={h} class="tap text-[15px] text-[var(--color-text-secondary)] hover:text-[var(--color-text)]" data-try={h === BREATHE_URL ? "" : undefined} data-at="footer">{l}</a></li>)}
            {c.h === "Legal" && <li><button type="button" data-consent-open hidden class="tap text-[15px] text-[var(--color-text-secondary)] hover:text-[var(--color-text)]">Privacy choices</button></li>}
          </ul>
        </div>
      ))}
    </div>
    <div class="t-foot mt-12 flex flex-col gap-2 border-t border-[var(--color-line)] pt-6 md:flex-row md:justify-between">
      <p>© 2026 Andningsappen Varberg AB · Org. nr 559496-1491 · Boråsgatan 12 B, 432 45 Varberg, Sweden</p>
      <p>Made with care in Varberg.</p>
    </div>
  </div>
</footer>

<script>
  // The newsletter posts to the WeHale API (/marketing/subscribe), which adds the contact to Loops with marketing consent.
  document.querySelectorAll<HTMLFormElement>("[data-newsletter]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
      const status = form.querySelector<HTMLElement>("[data-newsletter-status]")!;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { status.textContent = "Please enter a valid email address."; input.focus(); return; }
      button.disabled = true; button.textContent = "…";
      try {
        const res = await fetch(form.dataset.endpoint!, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email }) });
        if (!res.ok) throw new Error(String(res.status));
        status.textContent = "Thank you. The first letter will find you."; input.value = ""; button.textContent = "Done";
      } catch {
        status.textContent = "That didn't go through. Please try again."; button.disabled = false; button.textContent = "Subscribe";
      }
    });
  });
</script>
