---
/**
 * The consent banner (SITE-GOALS §5): small and calm, Accept and Decline of equal weight, and Settings for the two
 * choices (site measurement, ad measurement). Shown once, only when a tag is configured (docs/ENV.md) or with
 * ?consent=1 for review; remembered; reopened from the footer ("Privacy choices", [data-consent-open]).
 * Phones: a bottom sheet. Desktop: a small card, bottom left. /breathe (placement "top"): a card at the top of the
 * start screen, so it never sits over Begin, and it is hidden during the session.
 * Plain CSS, no Tailwind, so /breathe (which has none) can use it too. Copy: EN, and a Swedish draft for ?lang=sv.
 */
interface Props { placement?: "bottom" | "top" }
const { placement = "bottom" } = Astro.props;
const COPY = {
  en: {
    label: "Privacy choices",
    text: "May we use cookies to measure this visit? It shows us which ads bring people here and what they do next. Nothing runs unless you accept.",
    privacy: "Privacy", accept: "Accept", decline: "Decline", settings: "Settings",
    heading: "Choose what we may measure",
    analytics: "Site measurement", analyticsSub: "Google Analytics: which pages are used, and how.",
    ads: "Ad measurement", adsSub: "Meta and TikTok: which ads bring people here, and whether a session starts.",
    save: "Save choices", saved: "Saved. You can change this any time from the footer.",
  },
  sv: {   // DRAFT: for Isak to check
    label: "Integritetsval",
    text: "Får vi använda cookies för att mäta besöket? Det visar vilka annonser som leder hit och vad som händer sedan. Inget körs om du inte godkänner.",
    privacy: "Integritet", accept: "Godkänn", decline: "Avböj", settings: "Inställningar",
    heading: "Välj vad vi får mäta",
    analytics: "Mätning av sajten", analyticsSub: "Google Analytics: vilka sidor som används, och hur.",
    ads: "Mätning av annonser", adsSub: "Meta och TikTok: vilka annonser som leder hit, och om en session startas.",
    save: "Spara val", saved: "Sparat. Du kan ändra det när som helst längst ner på sidan.",
  },
};
---
<div class="whc" id="whConsent" data-pos={placement} role="region" aria-labelledby="whcLabel" hidden>
  <h2 class="whc-sr" id="whcLabel">{COPY.en.label}</h2>
  <div class="whc-ask" data-view="ask">
    <p class="whc-t"><span data-t="text">{COPY.en.text}</span> <a href="/privacy" data-t="privacy">{COPY.en.privacy}</a></p>
    <div class="whc-row">
      <button type="button" class="whc-b" data-act="accept" data-t="accept">{COPY.en.accept}</button>
      <button type="button" class="whc-b" data-act="decline" data-t="decline">{COPY.en.decline}</button>
    </div>
    <button type="button" class="whc-link" data-act="settings" data-t="settings" aria-expanded="false">{COPY.en.settings}</button>
  </div>
  <form class="whc-set" data-view="settings" hidden>
    <p class="whc-h" data-t="heading">{COPY.en.heading}</p>
    <label class="whc-opt">
      <span><b data-t="analytics">{COPY.en.analytics}</b><small data-t="analyticsSub">{COPY.en.analyticsSub}</small></span>
      <input type="checkbox" name="analytics" role="switch" />
    </label>
    <label class="whc-opt">
      <span><b data-t="ads">{COPY.en.ads}</b><small data-t="adsSub">{COPY.en.adsSub}</small></span>
      <input type="checkbox" name="ads" role="switch" />
    </label>
    <div class="whc-row whc-row1"><button type="submit" class="whc-b" data-t="save">{COPY.en.save}</button></div>
  </form>
  <p class="whc-done" data-view="done" role="status" hidden data-t="saved">{COPY.en.saved}</p>
</div>
<script type="application/json" id="whConsentCopy" set:html={JSON.stringify(COPY)} />

<style is:global>
  .whc { --whc-bg: linear-gradient(180deg, rgba(27, 34, 50, .97), rgba(19, 25, 38, .97)); --whc-ink: #f2f0ed; --whc-t2: rgba(242, 240, 237, .72);
    --whc-line: rgba(242, 240, 237, .22); position: fixed; z-index: 70; left: 0; right: 0; bottom: 0; box-sizing: border-box;
    padding: 18px 20px calc(env(safe-area-inset-bottom, 0px) + 16px); border-radius: 20px 20px 0 0; background: var(--whc-bg);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); box-shadow: 0 -12px 50px rgba(0, 0, 0, .45);
    font: 400 15px/1.5 "Nunito Sans", ui-sans-serif, system-ui, -apple-system, sans-serif; color: var(--whc-t2);
    animation: whcIn 520ms cubic-bezier(.33, 1, .68, 1) both; }
  .whc[hidden] { display: none; }
  .whc * { box-sizing: border-box; }
  @keyframes whcIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @media (min-width: 768px) { .whc[data-pos="bottom"] { left: 20px; right: auto; bottom: 20px; width: 384px; border-radius: 16px; padding: 18px 18px 14px; } }
  .whc[data-pos="top"] { --whc-bg: rgba(24, 16, 11, .94); --whc-ink: #f6ede3; --whc-t2: rgba(246, 237, 227, .78); --whc-line: rgba(246, 237, 227, .3);
    top: calc(env(safe-area-inset-top, 0px) + 10px); bottom: auto; left: 12px; right: 12px; max-width: 460px; margin: 0 auto;
    padding: 14px 14px 10px; border-radius: 16px; font-size: 14px; box-shadow: 0 8px 30px rgba(0, 0, 0, .35); animation-name: whcInTop; }
  @keyframes whcInTop { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: none; } }
  body.in-session .whc { display: none; }
  .whc-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; margin: -1px; }
  .whc p { margin: 0; }
  .whc a { color: var(--whc-ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--whc-line); }
  .whc-t { margin-bottom: 12px !important; }
  .whc-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .whc-row1 { grid-template-columns: 1fr; margin-top: 12px; }
  .whc-b { appearance: none; min-height: 44px; border-radius: 999px; border: 0; box-shadow: inset 0 0 0 1px var(--whc-line);
    background: rgba(255, 255, 255, .06); color: var(--whc-ink); font-family: inherit; font-weight: 700; font-size: 15px; line-height: 1; cursor: pointer;
    transition: background-color 220ms cubic-bezier(.33, 1, .68, 1), transform 220ms cubic-bezier(.33, 1, .68, 1); }
  .whc-b:hover { background: rgba(255, 255, 255, .11); }
  .whc-b:active { transform: scale(.97); }
  .whc-link { appearance: none; display: block; margin: 4px auto 0; min-height: 44px; padding: 0 12px; border: 0; background: none; cursor: pointer;
    color: var(--whc-t2); font-family: inherit; font-weight: 600; font-size: 14px; line-height: 1; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--whc-line); }
  .whc-h { color: var(--whc-ink); font-weight: 700; margin-bottom: 6px !important; }
  .whc-opt { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 56px; padding: 8px 0; border-bottom: 1px solid rgba(255, 255, 255, .07); cursor: pointer; }
  .whc-opt span { display: grid; gap: 2px; }
  .whc-opt b { color: var(--whc-ink); font-weight: 600; }
  .whc-opt small { font-size: 13px; line-height: 1.4; }
  .whc-opt input { appearance: none; -webkit-appearance: none; flex: none; position: relative; width: 46px; height: 28px; margin: 0; border-radius: 999px;
    background: rgba(255, 255, 255, .14); cursor: pointer; transition: background-color 220ms cubic-bezier(.33, 1, .68, 1); }
  .whc-opt input::after { content: ""; position: absolute; top: 3px; left: 3px; width: 22px; height: 22px; border-radius: 50%; background: var(--whc-ink);
    transition: transform 220ms cubic-bezier(.33, 1, .68, 1); }
  .whc-opt input:checked { background: var(--whc-ink); }
  .whc-opt input:checked::after { background: #131926; }
  .whc-opt input:checked::after { transform: translateX(18px); }
  .whc-done { color: var(--whc-ink); }
  .whc :focus-visible { outline: 2px solid var(--whc-ink); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .whc { animation: none; } .whc-b, .whc-opt input, .whc-opt input::after { transition: none; } }
</style>

<script>
  import { current, save } from "../../scripts/consent.js";
  import { ANY_TAG, startTags } from "../../scripts/tags.js";

  const root = document.getElementById("whConsent") as HTMLElement;
  const COPY = JSON.parse(document.getElementById("whConsentCopy")!.textContent || "{}");
  const Q = new URLSearchParams(location.search);
  const lang = (Q.get("lang") || document.documentElement.lang || "en").slice(0, 2) === "sv" ? "sv" : "en";
  const t = COPY[lang] || COPY.en;
  root.lang = lang;
  root.querySelectorAll<HTMLElement>("[data-t]").forEach((el) => { const k = el.dataset.t!; if (t[k]) el.textContent = t[k]; });
  document.getElementById("whcLabel")!.textContent = t.label;

  const view = (name: string) => root.querySelectorAll<HTMLElement>("[data-view]").forEach((el) => { el.hidden = el.dataset.view !== name; });
  const form = root.querySelector("form") as HTMLFormElement;
  const box = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  let closeTimer = 0;
  function open(settings = false) {
    clearTimeout(closeTimer);
    const c = current();
    box("analytics").checked = !!(c && c.analytics); box("ads").checked = !!(c && c.ads);
    view(settings ? "settings" : "ask");
    root.querySelector("[data-act=settings]")!.setAttribute("aria-expanded", String(settings));
    root.hidden = false;
    if (settings) box("analytics").focus({ preventScroll: true });
  }
  function done(state: { analytics: boolean; ads: boolean }, confirm = false) {
    save(state);
    if (!confirm) { root.hidden = true; return; }
    view("done"); closeTimer = window.setTimeout(() => { root.hidden = true; }, 2600);
  }
  root.querySelector("[data-act=accept]")!.addEventListener("click", () => done({ analytics: true, ads: true }));
  root.querySelector("[data-act=decline]")!.addEventListener("click", () => done({ analytics: false, ads: false }));
  root.querySelector("[data-act=settings]")!.addEventListener("click", () => open(true));
  form.addEventListener("submit", (e) => { e.preventDefault(); done({ analytics: box("analytics").checked, ads: box("ads").checked }, true); });
  addEventListener("keydown", (e) => { if (e.key === "Escape" && !root.hidden && current()) root.hidden = true; });

  // the footer link (and any [data-consent-open]) reopens the choice at any time
  document.querySelectorAll<HTMLElement>("[data-consent-open]").forEach((el) => {
    if (ANY_TAG || Q.get("consent") === "1") el.hidden = false;
    el.addEventListener("click", (e) => { e.preventDefault(); open(true); });
  });

  startTags();
  if ((ANY_TAG || Q.get("consent") === "1") && !current()) open(false);
  (window as any).__whConsent = { open, current };
</script>
