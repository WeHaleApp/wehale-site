---
/** Both stores, always together (audit H4). Quiet pills: the white one is "Try a session". */
import { APP_STORE_URL, PLAY_URL } from "./links";
interface Props { class?: string; at?: string }
const { class: cls = "", at = "page" } = Astro.props;
---
<div class:list={["flex flex-wrap gap-3", cls]}>
  <a href={APP_STORE_URL} rel="noopener" class="btn-quiet" data-store="app_store" data-at={at}>
    <svg class="h-[18px] w-[18px]" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M12.6 8.5c0-1.7 1.4-2.5 1.5-2.6-.8-1.2-2.1-1.4-2.5-1.4-1.1-.1-2.1.7-2.6.7-.5 0-1.3-.7-2.2-.7-1.1 0-2.2.7-2.8 1.7-1.2 2.1-.3 5.2.8 6.9.5.8 1.1 1.7 2 1.7.8 0 1.1-.5 2.1-.5 1 0 1.3.5 2.2.5.9 0 1.5-.8 2-1.6.6-.9.8-1.8.8-1.8-.1 0-1.5-.6-1.5-2.9z"/><path fill="currentColor" d="M10.7 2.7c.4-.5.7-1.2.6-1.9-.6 0-1.3.4-1.7.9-.4.5-.7 1.2-.6 1.9.6 0 1.3-.4 1.7-.9z"/></svg>
    App Store
  </a>
  <a href={PLAY_URL} rel="noopener" class="btn-quiet" data-store="google_play" data-at={at}>
    <svg class="h-[16px] w-[16px]" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M2.2 1.1 9 8l-6.8 6.9c-.3-.2-.5-.6-.5-1V2.1c0-.4.2-.8.5-1Zm7.5 7.6 1.9 1.9-8.2 4.7 6.3-6.6Zm0-1.4L3.4.7l8.2 4.7-1.9 1.9Zm2.6-1.5 2.2 1.3c.7.4.7 1.4 0 1.8l-2.2 1.3L10.3 8l2-2.2Z"/></svg>
    Google Play
  </a>
</div>
