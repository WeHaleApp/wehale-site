---
/**
 * Footer: the store buttons once, one quiet newsletter line (shown, not wired: no API calls from
 * the preview), and every page including Support, Investors and Credits. The partner pages are not
 * listed (see DIRECTION.md §5).
 */
import StoreButtons from "./StoreButtons.astro";
import { BREATHE_URL, BASE } from "./links";
const cols = [
  { h: "WeHale", links: [["Try a session", BREATHE_URL], ["Sessions", `${BASE}#sessions`], ["About", `${BASE}/about`]] },
  { h: "Help", links: [["Support", "/support"], ["hello@wehale.io", "mailto:hello@wehale.io"], ["Investors", "/investors"]] },
  { h: "Legal", links: [["Privacy", "/privacy"], ["Terms", "/terms"], ["Credits", "/credits"]] },
];
---
<footer class="border-t border-[var(--color-line)]" id="get-the-app">
  <div class="mx-auto max-w-6xl px-5 py-14 md:px-6 md:py-20">
    <div class="grid grid-cols-3 gap-x-6 gap-y-12 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="col-span-3 md:col-span-1">
        <img src="/assets/images/logo.svg" alt="WeHale" width="112" height="21" class="h-[21px] w-auto" />
        <p class="t-body mt-4 max-w-xs" data-was="Audio-guided breathwork for activation, balance, and calm. Five minutes is enough to feel the shift.">Guided breathing sessions, with a voice to follow. On iPhone and Android.</p>
        <StoreButtons class="mt-6" />
        <form class="mt-8 max-w-sm" onsubmit="return false" aria-label="Newsletter (preview, not connected)">
          <label for="nl" class="t-caption">Occasional letters</label>
          <div class="mt-3 flex gap-2">
            <input id="nl" type="email" placeholder="you@example.com" class="min-h-[48px] w-full rounded-[var(--radius-pill)] bg-[var(--color-glass)] px-4 text-base text-[var(--color-text)] outline-none ring-1 ring-[var(--color-line-strong)] placeholder:text-[var(--color-text-muted)] focus:ring-[var(--color-text-secondary)]" />
            <button type="submit" class="btn shrink-0 !px-5">Subscribe</button>
          </div>
          <p class="t-foot mt-2">A few emails a year. Unsubscribe any time. <a href="/privacy" class="link !font-normal">Privacy</a></p>
        </form>
      </div>
      {cols.map((c) => (
        <div>
          <h2 class="t-caption">{c.h}</h2>
          <ul class="mt-4 space-y-3">
            {c.links.map(([l, h]) => <li><a href={h} class="text-[15px] text-[var(--color-text-secondary)] hover:text-[var(--color-text)]">{l}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="t-foot mt-14 flex flex-col gap-2 border-t border-[var(--color-line)] pt-6 md:flex-row md:justify-between">
      <p>© 2026 Andningsappen Varberg AB</p>
      <p>Made with care in Varberg, Sweden.</p>
    </div>
  </div>
</footer>
