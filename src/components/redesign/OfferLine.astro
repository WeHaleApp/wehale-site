---
/**
 * The one sentence about what a newcomer gets, in the app's own Welcome words (audit H3). Access
 * wording is Isak's: marked pending until he says yes. Used in the hero, the end of each page and,
 * later, the /breathe end screen and Support, so they never drift apart.
 */
interface Props { class?: string }
const { class: cls = "" } = Astro.props;
---
<p class:list={["t-foot", cls]} data-pending="access wording (the app's Welcome screen words)">
  Your first 14 days are free, with everything open. No card needed.
</p>
