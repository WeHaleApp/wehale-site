---
/**
 * Newsletter signup. Posts to the WeHale API (/marketing/subscribe),
 * which upserts the contact into Loops with marketing consent.
 * Replaces the earlier Buttondown stub that never delivered emails.
 */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const SUBSCRIBE_URL = "https://wehale-app-production.up.railway.app/marketing/subscribe";
---

<form
  class:list={["w-full", compact ? "" : "max-w-md"]}
  data-newsletter-form
  data-endpoint={SUBSCRIBE_URL}
  novalidate
>
  <label class="block">
    {!compact && (
      <span class="eyebrow block mb-3">Stay in the loop</span>
    )}
    <div class="flex items-stretch gap-2 rounded-full border border-[var(--color-line-strong)] bg-[var(--color-bg-raised)] p-1">
      <input
        type="email"
        name="email"
        required
        placeholder="your@email.com"
        aria-label="Email address"
        class="flex-1 bg-transparent px-4 py-2 text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-tertiary)] outline-none"
      />
      <button
        type="submit"
        class="rounded-full bg-[var(--color-accent)] px-4 py-2 text-sm font-semibold text-[var(--color-bg)] hover:opacity-90 transition-opacity"
      >
        Subscribe
      </button>
    </div>
    <span class="mt-3 block text-xs text-[var(--color-text-tertiary)]" data-newsletter-status>
      {!compact && "Occasional notes from the team. No fluff. Unsubscribe anytime."}
    </span>
  </label>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[name="email"]');
      const status = form.querySelector<HTMLElement>("[data-newsletter-status]");
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const email = input?.value.trim() ?? "";
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        if (status) status.textContent = "Please enter a valid email address.";
        return;
      }
      if (button) { button.disabled = true; button.textContent = "…"; }
      try {
        const res = await fetch(form.dataset.endpoint!, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        if (!res.ok) throw new Error();
        if (status) status.textContent = "You're in. Welcome — first note coming soon.";
        if (input) input.value = "";
        if (button) button.textContent = "Done ✓";
      } catch {
        if (status) status.textContent = "Something went wrong — please try again.";
        if (button) { button.disabled = false; button.textContent = "Subscribe"; }
      }
    });
  });
</script>
