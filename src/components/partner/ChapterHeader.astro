---
/**
 * The opener of the chapter room: the chosen way's name and its one-line promise. Since 2026-09-03
 * the three ways are not stacked; the cards select and this room swaps, so the header carries no
 * number (numbers said "sequence", and there is none).
 */
interface Props { title: string; promise?: string }
const { title } = Astro.props;
---

<div class="border-b border-[var(--color-line)]">
  <div class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-8 gap-y-2 px-6 pb-7 pt-9 md:pb-8 md:pt-10">
    <h2 class="text-2xl font-semibold md:text-3xl">{title}</h2>
    <p class="hidden text-sm text-[var(--color-text-tertiary)] md:block">Hur det ser ut · siffrorna · hur vi börjar · villkoren</p>
  </div>
</div>
