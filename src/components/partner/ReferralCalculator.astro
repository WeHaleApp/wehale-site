---
/**
 * The referral model's business case, for partners with reach (Isak, 2026-09-03: "influencers
 * eller partners som kan nå många personer i relevant målgrupp via exempelvis nyhetsbrev. Låt
 * säga att dem kan sälja 1000 årsmedlemskap per år och dem får 400 kr per sälj").
 * Two numbers, one multiplication, said out loud.
 */
import type { Partner } from "../../lib/partner";

interface Props { partner: Partner }
const { partner: p } = Astro.props;
const annualHalf = Math.round(p.annualPrice / 2);
---

<div class="p-card p-6 md:p-8" data-refcalc data-annual={p.annualPrice} data-annual-half={annualHalf}>
  <div class="grid gap-6 md:grid-cols-2">
    <label class="block">
      <span class="text-sm text-[var(--color-text-secondary)]">Årsmedlemskap du säljer per år</span>
      <input class="p-input mt-2" type="number" inputmode="numeric" min="0" step="10" value={p.annualSalesPerYear} data-sales />
      <span class="mt-1 block text-xs text-[var(--color-text-tertiary)]">Vet du inte? En till tre procent av dem du når regelbundet är en vanlig tumregel.</span>
    </label>
    <label class="block">
      <span class="text-sm text-[var(--color-text-secondary)]">Din ersättning per sålt årsmedlemskap, kr</span>
      <input class="p-input mt-2" type="number" inputmode="numeric" min="0" step="50" value={p.payoutPerAnnualSale} data-payout />
      <span class="mt-1 block text-xs text-[var(--color-text-tertiary)]">Sätts per partner. Det här är vårt förslag till dig.</span>
    </label>
  </div>

  <div class="mt-8 grid gap-6 md:grid-cols-3">
    <div>
      <p class="text-xs text-[var(--color-text-tertiary)]">till dig per år</p>
      <p class="p-num mt-2 text-[var(--color-accent)]" data-out="year">0 kr</p>
      <p class="mt-2 text-sm text-[var(--color-text-secondary)]">utbetalt månadsvis, månaden efter köpet</p>
    </div>
    <div>
      <p class="text-xs text-[var(--color-text-tertiary)]">till dig per månad</p>
      <p class="p-num mt-2" data-out="month">0 kr</p>
      <p class="mt-2 text-sm text-[var(--color-text-secondary)]">om försäljningen är jämn över året</p>
    </div>
    <div>
      <p class="text-xs text-[var(--color-text-tertiary)]">dina följare betalar</p>
      <p class="p-num mt-2">{annualHalf} kr</p>
      <p class="mt-2 text-sm text-[var(--color-text-secondary)]">för ett år, i stället för {p.annualPrice} kr. Rabatten står vi för.</p>
    </div>
  </div>

  <div class="mt-8 border-t border-[var(--color-line)] pt-5 text-sm text-[var(--color-text-secondary)]">
    <p><span class="font-semibold text-[var(--color-text)]">Så här räknar vi:</span> <span data-out="chain"></span></p>
    <p class="mt-2">Räknat på årsmedlemskap. Väljer någon månadsplan i stället får du {p.commissionPercent} % av det de betalar i {p.commissionMonths} månader. Förnyar ett årsmedlemskap året därpå räknas det som ett nytt sälj.</p>
  </div>
</div>

<script>
  const kr = (n: number) => `${Math.round(n).toLocaleString("sv-SE")} kr`;
  const int = (n: number) => Math.round(n).toLocaleString("sv-SE");
  document.querySelectorAll<HTMLElement>("[data-refcalc]").forEach((root) => {
    const num = (sel: string) => Number(root.querySelector<HTMLInputElement>(sel)?.value) || 0;
    const set = (k: string, v: string) => root.querySelectorAll<HTMLElement>(`[data-out="${k}"]`).forEach((el) => (el.textContent = v));
    const render = () => {
      const sales = Math.max(0, num("[data-sales]"));
      const payout = Math.max(0, num("[data-payout]"));
      const year = sales * payout;
      set("year", kr(year));
      set("month", kr(year / 12));
      set("chain", `${int(sales)} sålda årsmedlemskap × ${kr(payout)} = ${kr(year)} per år, ${kr(year / 12)} i månaden.`);
    };
    root.querySelectorAll("input").forEach((i) => i.addEventListener("input", render));
    render();
  });
</script>
