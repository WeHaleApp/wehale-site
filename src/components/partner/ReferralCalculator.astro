---
/**
 * The referral model's business case, as simply as the checkout one: how many guests they reach,
 * how many take the offer, how many of those become paying, and what X % of that is. The offer
 * shape is a choice on the page because it is a choice per partner (Isak, 2026-09-03).
 */
import type { Partner } from "../../lib/partner";

interface Props { partner: Partner }
const { partner: p } = Astro.props;
const annualHalf = Math.round(p.annualPrice / 2);
---

<div
  class="p-card p-6 md:p-8"
  data-refcalc
  data-monthly={p.monthlyPrice}
  data-annual-half={annualHalf}
  data-pct={p.commissionPercent}
  data-months={p.commissionMonths}
>
  <div class="grid gap-6 md:grid-cols-3">
    <label class="block">
      <span class="text-sm text-[var(--color-text-secondary)]">Gäster du når per månad</span>
      <input class="p-input mt-2" type="number" inputmode="numeric" min="0" step="10" value={p.guestsPerMonth} data-guests />
      <span class="mt-1 block text-xs text-[var(--color-text-tertiary)]">Klasser, nyhetsbrev, retreats. Räkna personer, inte visningar.</span>
    </label>
    <label class="block">
      <span class="text-sm text-[var(--color-text-secondary)]">Andel som tar erbjudandet, %</span>
      <input class="p-input mt-2" type="number" inputmode="numeric" min="0" max="100" value="10" data-take />
    </label>
    <label class="block">
      <span class="text-sm text-[var(--color-text-secondary)]">Andel av dem som blir betalande, %</span>
      <input class="p-input mt-2" type="number" inputmode="numeric" min="0" max="100" value="30" data-pay />
      <span class="mt-1 block text-xs text-[var(--color-text-tertiary)]">Det här mäter vi tillsammans. Byt siffran.</span>
    </label>
  </div>

  <div class="mt-8 rounded-[var(--radius-md)] border border-[var(--color-accent-line)] bg-[var(--color-accent-soft)] p-5">
    <p class="font-semibold">Erbjudandet till dina gäster, ditt val</p>
    <div class="mt-3 grid gap-3 md:grid-cols-2">
      <label class="flex cursor-pointer items-center gap-3 rounded-[var(--radius-sm)] border border-[var(--color-line-strong)] bg-[var(--color-bg)] px-4 py-3 has-[:checked]:border-[var(--color-accent)]">
        <input type="radio" name="ref-offer" value="trial90" checked={p.referralOffer === "trial90"} class="accent-[#4fcbd6]" data-offer />
        <span>
          <span class="block font-semibold">{p.teamCodeDays} dagar gratis</span>
          <span class="block text-sm text-[var(--color-text-secondary)]">sedan {p.monthlyPrice} kr per månad, avbryt när du vill</span>
        </span>
      </label>
      <label class="flex cursor-pointer items-center gap-3 rounded-[var(--radius-sm)] border border-[var(--color-line-strong)] bg-[var(--color-bg)] px-4 py-3 has-[:checked]:border-[var(--color-accent)]">
        <input type="radio" name="ref-offer" value="annual50" checked={p.referralOffer === "annual50"} class="accent-[#4fcbd6]" data-offer />
        <span>
          <span class="block font-semibold">50 % på årsabonnemanget</span>
          <span class="block text-sm text-[var(--color-text-secondary)]">{annualHalf} kr för ett år, betalas direkt</span>
        </span>
      </label>
    </div>
  </div>

  <div class="mt-8 grid gap-6 md:grid-cols-3">
    <div>
      <p class="text-xs text-[var(--color-text-tertiary)]">nya WeHale-användare per månad</p>
      <p class="p-num mt-2" data-out="users">0</p>
      <p class="mt-2 text-sm text-[var(--color-text-secondary)]">i ditt namn, med ditt erbjudande</p>
    </div>
    <div>
      <p class="text-xs text-[var(--color-text-tertiary)]">som blir betalande</p>
      <p class="p-num mt-2" data-out="paying">0</p>
      <p class="mt-2 text-sm text-[var(--color-text-secondary)]" data-out="payingNote"></p>
    </div>
    <div>
      <p class="text-xs text-[var(--color-text-tertiary)]" data-out="commLabel">din provision per månad</p>
      <p class="p-num mt-2 text-[var(--color-accent)]" data-out="commission">0 kr</p>
      <p class="mt-2 text-sm text-[var(--color-text-secondary)]" data-out="commNote"></p>
    </div>
  </div>

  <div class="mt-8 border-t border-[var(--color-line)] pt-5 text-sm text-[var(--color-text-secondary)]">
    <p><span class="font-semibold text-[var(--color-text)]">Så här räknar vi:</span> <span data-out="chain"></span></p>
    <p class="mt-2">Provisionen är {p.commissionPercent} % av det gästen betalar oss, i {p.commissionMonths} månader från första köpet. Redovisas månadsvis i din egen vy.</p>
  </div>
</div>

<script>
  const kr = (n: number) => `${Math.round(n).toLocaleString("sv-SE")} kr`;
  const int = (n: number) => Math.round(n).toLocaleString("sv-SE");
  document.querySelectorAll<HTMLElement>("[data-refcalc]").forEach((root) => {
    const monthly = Number(root.dataset.monthly);
    const annualHalf = Number(root.dataset.annualHalf);
    const pct = Number(root.dataset.pct) / 100;
    const months = Number(root.dataset.months);
    const num = (sel: string) => Number(root.querySelector<HTMLInputElement>(sel)?.value) || 0;
    const set = (k: string, v: string) => root.querySelectorAll<HTMLElement>(`[data-out="${k}"]`).forEach((el) => (el.textContent = v));
    const render = () => {
      const guests = Math.max(0, num("[data-guests]"));
      const take = Math.min(100, Math.max(0, num("[data-take]"))) / 100;
      const pay = Math.min(100, Math.max(0, num("[data-pay]"))) / 100;
      const offer = root.querySelector<HTMLInputElement>("[data-offer]:checked")?.value ?? "trial90";
      const users = guests * take;
      const paying = users * pay;
      set("users", int(users));
      set("paying", int(paying));
      if (offer === "trial90") {
        const perMonth = paying * monthly * pct;
        set("payingNote", `efter de fria dagarna, ${kr(monthly)} per månad var`);
        set("commLabel", "din provision per månad, från en månads gäster");
        set("commission", kr(perMonth));
        set("commNote", `så länge de stannar, i upp till ${months} månader. Varje ny månads gäster lägger på en rad till.`);
        set("chain", `${int(guests)} gäster, ${int(take * 100)} % tar erbjudandet: ${int(users)} nya användare. ${int(pay * 100)} % blir betalande: ${int(paying)} personer à ${kr(monthly)} per månad. ${int(pct * 100)} % av det är ${kr(perMonth)} till dig, varje månad de stannar.`);
      } else {
        const once = paying * annualHalf * pct;
        set("payingNote", `köper året direkt, ${kr(annualHalf)} var`);
        set("commLabel", "din provision, vid köpet");
        set("commission", kr(once));
        set("commNote", `från en månads gäster, utbetald månaden efter. Förnyar de året därpå får du ${int(pct * 100)} % igen.`);
        set("chain", `${int(guests)} gäster, ${int(take * 100)} % tar erbjudandet: ${int(users)} nya användare. ${int(pay * 100)} % köper året: ${int(paying)} personer à ${kr(annualHalf)}. ${int(pct * 100)} % av det är ${kr(once)} till dig.`);
      }
    };
    root.querySelectorAll("input").forEach((i) => i.addEventListener("input", render));
    render();
  });
</script>
