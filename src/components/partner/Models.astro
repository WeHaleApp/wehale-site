---
/**
 * The three ways to work together, as three cards, each with a small scene built in HTML so the
 * reader sees the way before reading it (Isak, 2026-09-03: "nått mer visuellt och inte bara 3
 * text rutor"). Names are short and from the partner's side: Gåvan i kassan, Ambassadör,
 * Gästkoden. The partner's JSON says which ways the page proposes; on a named page with fewer
 * than three, the proposed ones carry a pill and the others are named in one line.
 */
import type { Partner, PartnerModel } from "../../lib/partner";
import { MODEL_NAMES } from "../../lib/partner";

interface Props { partner: Partner; generic?: boolean }
const { partner: p, generic = false } = Astro.props;

const offerShort = p.referralOffer === "annual50" ? "50 % på årsmedlemskapet" : `${p.teamCodeDays} dagar gratis`;
const linkSlug = p.slug || "din-studio";
const accent = p.accent ?? "#0f766e";

const cards: { key: PartnerModel; n: string; tag: string; title: string; body: string; who: string; href: string }[] = [
  {
    key: "checkout",
    n: "1",
    tag: "Fler slutför köpet",
    title: MODEL_NAMES.checkout,
    body: `Vi finansierar en rabatt på dina produkter. Gästen ser ${p.guestDiscountMonthly} kr rabatt i sista steget och får ${p.guestTrialDays} dagar WeHale Pro. Du får fullt pris på köpet, och fler som slutför det.`,
    who: "För dig med bokningssystem eller webbshop.",
    href: "#kassa",
  },
  {
    key: "referral",
    n: "2",
    tag: "En ny intäktsrad",
    title: MODEL_NAMES.referral,
    body: `För dig som når många. Dina följare får ${offerShort} med din länk eller din kod. Blir de kunder får du ${p.commissionPercent} % av allt de betalar under sitt första år, årsmedlemskap och månadsplan lika.`,
    who: "För nyhetsbrev, communities, poddar och plattformar med räckvidd.",
    href: "#rekommendation",
  },
  {
    key: "gift",
    n: "3",
    tag: "Enklast",
    title: MODEL_NAMES.gift,
    body: `${p.teamCodeDays} dagar WeHale Pro till alla dina gäster, i ditt namn. Inga pengar åt något håll. För dig som tycker appen är bra och vill ge bort den.`,
    who: "För dig som vill börja litet, i dag.",
    href: "#gava",
  },
];
const proposed = new Set(p.models);
const subset = !generic && proposed.size < 3;
const shown = subset ? cards.filter((c) => proposed.has(c.key)) : cards;
const others = subset ? cards.filter((c) => !proposed.has(c.key)) : [];
const cols = shown.length === 1 ? "md:grid-cols-1 md:max-w-2xl" : shown.length === 2 ? "md:grid-cols-2" : "md:grid-cols-3";
---

<div class:list={["grid gap-5", cols]}>
  {shown.map((c) => (
    <a href={c.href} class="p-card group flex flex-col overflow-hidden transition-colors hover:border-[var(--color-accent-line)]">
      <!-- ─── The scene ─── -->
      <div class="relative h-44 overflow-hidden border-b border-[var(--color-line)]" aria-hidden="true">
        {c.key === "checkout" && (
          <div class="absolute inset-0 bg-[#f4f6f8]">
            <div class="absolute left-5 right-5 top-5 rounded-xl bg-white p-3 text-[#111827] shadow-[0_10px_30px_rgba(0,0,0,.12)]">
              <div class="flex items-start gap-2.5">
                <span class="mt-0.5 grid h-4 w-4 shrink-0 place-items-center rounded bg-[#4fcbd6]"><svg viewBox="0 0 12 12" class="h-2.5 w-2.5"><path d="M2 6.2 4.7 9 10 3.5" fill="none" stroke="#08111f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span class="flex-1">
                  <span class="flex items-center justify-between text-[11px] font-semibold"><span>Lägg till WeHale Pro</span><img src="/assets/images/logo.svg" alt="" class="h-2.5 w-auto invert" /></span>
                  <span class="mt-0.5 block text-[10px] text-[#374151]">0 kr i dag · {p.guestDiscountMonthly} kr rabatt på den här ordern</span>
                </span>
              </div>
            </div>
            <div class="absolute bottom-5 left-5 right-5 rounded-xl bg-white p-3 text-[#111827] shadow-[0_10px_30px_rgba(0,0,0,.12)]">
              <div class="flex justify-between text-[10px] text-[#6b7280]"><span>{p.commonPurchase}</span><span>{p.avgOrder} kr</span></div>
              <div class="mt-1 flex justify-between text-[10px] font-medium text-[#0f9aa6]"><span>WeHale-rabatt</span><span>−{p.guestDiscountMonthly} kr</span></div>
              <div class="mt-1.5 flex items-end justify-between border-t border-[#e5e7eb] pt-1.5 text-[11px] font-semibold"><span>Att betala i dag</span><span class="text-[14px]">{p.avgOrder - p.guestDiscountMonthly} kr</span></div>
            </div>
            <div class="absolute right-6 top-0 rounded-b-md px-2 py-0.5 text-[9px] font-extrabold uppercase tracking-[0.14em] text-white" style={`background:${accent}`}>{p.name}</div>
          </div>
        )}
        {c.key === "referral" && (
          <div class="absolute inset-0 bg-gradient-to-br from-[#0f1a33] to-[#0a1224]">
            <img src="/assets/images/sessions/03-echoes-of-strength.webp" alt="" class="absolute inset-0 h-full w-full object-cover opacity-25" loading="lazy" />
            <div class="absolute inset-x-5 top-6 flex items-center gap-2 rounded-full bg-white/95 px-3.5 py-2 text-[#111827] shadow-[0_10px_30px_rgba(0,0,0,.35)]">
              <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[#4fcbd6]"><svg viewBox="0 0 12 12" class="h-3 w-3"><path d="M5 7l2-2M4.2 8.3a1.6 1.6 0 0 1 0-2.3l1-1a1.6 1.6 0 0 1 2.3 0M7.8 3.7a1.6 1.6 0 0 1 0 2.3l-1 1a1.6 1.6 0 0 1-2.3 0" fill="none" stroke="#08111f" stroke-width="1.2" stroke-linecap="round"/></svg></span>
              <span class="truncate text-[11px] font-semibold">wehale.io/for/{linkSlug}</span>
            </div>
            <div class="absolute inset-x-5 bottom-6 grid grid-cols-2 gap-2">
              <div class="rounded-xl bg-white/10 p-3 backdrop-blur">
                <p class="text-[9px] uppercase tracking-[0.12em] text-white/60">Dina följare</p>
                <p class="mt-1 text-[12px] font-semibold leading-tight text-white">{offerShort}</p>
              </div>
              <div class="rounded-xl bg-[#4fcbd6]/15 p-3 backdrop-blur">
                <p class="text-[9px] uppercase tracking-[0.12em] text-[#4fcbd6]/80">Du</p>
                <p class="mt-1 text-[12px] font-semibold leading-tight text-[#4fcbd6]">{p.commissionPercent} % i {p.commissionMonths} mån</p>
              </div>
            </div>
          </div>
        )}
        {c.key === "gift" && (
          <div class="absolute inset-0">
            <img src="/assets/images/sessions/02-coherent-heart.webp" alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#06101f] via-[#06101f]/50 to-transparent"></div>
            <div class="absolute inset-x-5 bottom-5 rounded-xl border border-white/15 bg-[#0b1220]/85 p-3 text-white backdrop-blur">
              <div class="flex items-center justify-between">
                <img src="/assets/images/logo.svg" alt="" class="h-3 w-auto" />
                <span class="rounded-full bg-[#4fcbd6]/20 px-2 py-0.5 text-[9px] font-semibold text-[#4fcbd6]">{p.teamCodeDays} dagar</span>
              </div>
              <p class="mt-2 text-[11px] leading-snug">{p.name} har valt WeHale för sina gäster.</p>
            </div>
          </div>
        )}
      </div>

      <!-- ─── The words ─── -->
      <div class="flex flex-1 flex-col p-6">
        <div class="flex items-center justify-between gap-3">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-[var(--color-line-strong)] text-sm font-semibold">{c.n}</span>
          {subset
            ? <span class="rounded-full bg-[var(--color-accent-soft)] px-3 py-1 text-xs font-semibold text-[var(--color-accent)]">Vårt förslag för {p.name}</span>
            : <span class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-gold)]">{c.tag}</span>}
        </div>
        <h3 class="mt-5 text-xl font-semibold">{c.title}</h3>
        <p class="p-body mt-3 flex-1 text-base">{c.body}</p>
        <p class="mt-5 text-sm text-[var(--color-text-tertiary)]">{c.who}</p>
        <span class="mt-4 text-sm font-semibold text-[var(--color-accent)] group-hover:underline">Till kapitlet</span>
      </div>
    </a>
  ))}
</div>
{others.length > 0 && (
  <p class="mt-6 text-sm text-[var(--color-text-tertiary)]">
    Det finns {others.length === 1 ? "ett annat sätt" : "andra sätt"} också: {others.map((o) => o.title.toLowerCase()).join(" och ")}. Passar det bättre säger du till {p.ourContactName}.
  </p>
)}
