        const demo = document.querySelector<HTMLElement>("[data-demo-home] .demo");
        const home = document.querySelector<HTMLElement>("[data-demo-home]");
        const teaserSlot = document.querySelector<HTMLElement>("[data-demo-teaser-slot]");
        const overlay = document.querySelector<HTMLElement>("[data-demo-overlay]");
        const slot = document.querySelector<HTMLElement>("[data-demo-slot]");
        const mobile = window.matchMedia("(max-width: 767px)");
        // The chapter section animates with a transform, which would make it the containing block of a
        // fixed overlay; the overlay lives on body instead.
        if (overlay) document.body.appendChild(overlay);
        const place = () => { if (!demo || !home || !teaserSlot) return; if (overlay?.classList.contains("flex")) return; (mobile.matches ? teaserSlot : home).appendChild(demo); };
        const open = () => { if (!demo || !overlay || !slot) return; slot.appendChild(demo); demo.setAttribute("data-fullscreen", ""); overlay.classList.remove("hidden"); overlay.classList.add("flex"); document.documentElement.style.overflow = "hidden"; };
        const close = () => { if (!demo || !overlay) return; demo.removeAttribute("data-fullscreen"); overlay.classList.add("hidden"); overlay.classList.remove("flex"); document.documentElement.style.overflow = ""; place(); };
        document.querySelector("[data-demo-open]")?.addEventListener("click", open);
        document.querySelector("[data-demo-close]")?.addEventListener("click", close);
        window.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
        mobile.addEventListener("change", () => { if (!mobile.matches) close(); else place(); });
        place();
      </script>
