---
/**
 * The whole partner page in one component, one story: the product, then "try it yourself"
 * (the owner's lifetime QR), then the three ways to work together, then the detail of each way
 * the page proposes (checkout mock + calculator; referral calculator; the gift), then how to
 * start, the terms, the next step. Every string that names the partner comes from the JSON; the
 * generic page passes GENERIC and `generic`, and shows all three ways.
 */
import type { Partner } from "../../lib/partner";
import { APP_STORE_URL, codeLink, kr } from "../../lib/partner";
import CheckoutDemo from "./CheckoutDemo.astro";
import Calculator from "./Calculator.astro";
import ReferralCalculator from "./ReferralCalculator.astro";
import Models from "./Models.astro";
import Timeline from "./Timeline.astro";
import OwnerQr from "./OwnerQr.astro";

interface Props { partner: Partner; generic?: boolean }
const { partner: p, generic = false } = Astro.props;

const has = (m: Partner["models"][number]) => p.models.includes(m);
const eyebrow = generic
  ? "Ett förslag från WeHale · för studios, lärare och plattformar"
  : `För ${p.name} · ett förslag från WeHale`;
const greeting = !generic && p.contactName ? `Hej ${p.contactName}.` : null;
const mailto = p.ourContactEmail
  ? `mailto:${p.ourContactEmail}?subject=${encodeURIComponent(`WeHale och ${p.name}`)}`
  : null;
const offer = p.referralOffer === "annual50" ? "50 % på årsabonnemanget" : `${p.teamCodeDays} dagar gratis`;
const guestCodeExample = p.teamCode.replace(/-TEAM$/i, "");

const covers = [
  { src: "/assets/images/sessions/01-box-breath.webp", title: "Box Breath", meta: "Calm" },
  { src: "/assets/images/sessions/02-coherent-heart.webp", title: "Coherent Heart", meta: "Balance" },
  { src: "/assets/images/sessions/03-echoes-of-strength.webp", title: "Echoes of Strength", meta: "Activate" },
  { src: "/assets/images/sessions/06-nighttime-serenity.webp", title: "Nighttime Serenity", meta: "Sömn" },
];

const terms: [string, string][] = [];
if (has("checkout")) terms.push(["Gästens rabatt", `${p.guestDiscountMonthly} kr på månadsplan (${p.guestTrialDays} dagar gratis) · ${p.guestDiscountAnnual} kr på årsplan (${kr(p.annualPrice)}, betalas direkt). Vi står för rabatten. Du får fullt pris.`]);
if (has("referral")) {
  terms.push(["Din provision", `${p.commissionPercent} % av det gästen betalar oss, i ${p.commissionMonths} månader från första köpet.`]);
  terms.push(["Erbjudandet", `Sätts per partner. I dag: ${offer}. Kan bytas mellan kampanjer.`]);
}
if (has("gift")) terms.push(["Gästkoden", `${p.teamCodeDays} dagar WeHale Pro till dina gäster, i ditt namn. Inga pengar åt något håll.`]);
if (has("checkout") || has("referral")) terms.push(["Utbetalning och redovisning", "Månadsvis via Stripe, redovisad i din egen vy."]);
terms.push(["Bindning", "Ingen. Pausa eller avsluta när som helst."]);
terms.push(["Exklusivitet", "Vi kan lova att vara den enda appen hos dig. Vi ber inte om motsvarande."]);
terms.push(["Gästens skydd", "Inget är förvalt. Påminnelse en vecka före första dragningen. Avbryt i appen med två tryck."]);

const timelineMode = has("checkout") ? "checkout" : "share";
---

<!-- ─── Hero ─── -->
<section class="relative isolate overflow-hidden" id="top">
  <div class="absolute inset-0 -z-10 bg-[var(--color-bg)]" aria-hidden="true">
    <!-- A still from the brand film (WH_16x9, 39 s): the closed eyes are the brand's calm.
         Mobile: a top band, text beneath it. Desktop: the right 62 %, text to its left. -->
    <div class="absolute inset-x-0 top-0 h-[52%] md:inset-y-0 md:left-[38%] md:h-auto">
      <img
        src="/assets/images/partner/hero-eyes-closed-1920.webp"
        srcset="/assets/images/partner/hero-eyes-closed-1920.webp 1920w, /assets/images/partner/hero-eyes-closed.webp 2560w"
        sizes="(min-width: 768px) 62vw, 100vw"
        alt=""
        class="h-full w-full object-cover object-[62%_30%] md:object-[60%_35%]"
        fetchpriority="high"
      />
      <div class="absolute inset-0 hidden bg-gradient-to-r from-[var(--color-bg)] via-[var(--color-bg)]/10 to-transparent md:block" style="width: 55%;"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-bg)]/25 via-transparent to-[var(--color-bg)] md:hidden"></div>
      <div class="absolute inset-0 bg-[var(--color-bg)]/10 md:bg-[var(--color-bg)]/15"></div>
    </div>
    <div class="absolute inset-0 hidden bg-gradient-to-b from-[var(--color-bg)]/30 via-transparent to-[var(--color-bg)] md:block"></div>
  </div>
  <div class="mx-auto flex min-h-[92dvh] max-w-6xl flex-col justify-end px-6 pb-16 pt-[46dvh] md:min-h-[78dvh] md:pb-20 md:pt-32">
    <p class="p-eyebrow" data-reveal>{eyebrow}</p>
    {greeting && <p class="mt-6 text-lg text-[var(--color-text-secondary)]" data-reveal>{greeting}</p>}
    <h1 class="mt-4 max-w-3xl text-[clamp(2.5rem,6vw,5rem)] font-medium leading-[1.05] tracking-tight" data-reveal>
      Andning som dina gäster tar med sig hem.
    </h1>
    <p class="p-body mt-6 max-w-xl" data-reveal>
      Först en app vi vill att du provar själv, för att avgöra om den är något du vill sätta ditt namn bakom. Sedan {generic ? "tre sätt" : p.models.length === 1 ? "ett sätt" : "några sätt"} att låta dina gäster få den, som gynnar dig också. Du väljer ordning och takt.
    </p>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row" data-reveal>
      <a href="#prova" class="p-btn">Prova appen</a>
      <a href="#modeller" class="p-btn-ghost">Se samarbetet</a>
    </div>
  </div>
</section>

<!-- ─── The app ─── -->
<section class="mx-auto max-w-6xl px-6 py-20 md:py-24" id="app">
  <div class="grid items-center gap-12 md:grid-cols-2">
    <div>
      <p class="p-eyebrow" data-reveal>Vad WeHale är</p>
      <h2 class="p-h2 mt-4" data-reveal>Guidad andning. Fem till tjugofem minuter. Byggd med samma omsorg som en bra klass.</h2>
      <div class="mt-10 grid gap-6" data-reveal>
        <div>
          <p class="font-semibold">Sessioner</p>
          <p class="p-body mt-1 text-base">Tre kategorier: Calm, Balance och Activate. En morgon, en lunchrast, en kväll. Guidade av röst, i ett tempo man kan följa.</p>
        </div>
        <div>
          <p class="font-semibold">Startkurs</p>
          <p class="p-body mt-1 text-base">Fem dagar, en övning om dagen, korta lektioner före varje session. För den som aldrig andats medvetet.</p>
        </div>
        <div>
          <p class="font-semibold">Hållning</p>
          <p class="p-body mt-1 text-base">Ingen hype. Inga floskler. Ingen skuld när man missar en dag. Tre sessioner är alltid gratis.</p>
        </div>
      </div>
    </div>
    <div class="relative mx-auto flex w-full max-w-md items-start justify-center gap-4 md:block" data-reveal>
      <img src="/assets/images/screens/01-home.webp" alt="WeHale, hemskärmen" class="w-[46%] rounded-[1.6rem] shadow-[0_30px_80px_rgba(0,0,0,.5)] md:w-[58%] md:rounded-[2rem]" loading="lazy" />
      <img src="/assets/images/screens/03-player.webp" alt="WeHale, en session spelas" class="mt-10 w-[46%] rounded-[1.6rem] shadow-[0_30px_80px_rgba(0,0,0,.5)] md:absolute md:-right-2 md:top-16 md:mt-0 md:w-[58%] md:rounded-[2rem]" loading="lazy" />
    </div>
  </div>
</section>

<!-- ─── What we believe ─── -->
<section class="relative isolate overflow-hidden" id="tro">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <img src="/assets/images/partner/forest-dawn.webp" alt="" class="h-full w-full object-cover object-center" loading="lazy" />
    <div class="absolute inset-0 bg-[var(--color-bg)]/60"></div>
  </div>
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-28">
    <p class="mx-auto max-w-3xl text-center text-[clamp(1.75rem,4vw,3rem)] font-medium leading-[1.15]" data-reveal>
      Ingen hype. Inga floskler. Ingen skuld när man missar en dag.
    </p>
    <p class="mt-5 text-center text-[var(--color-text-secondary)]" data-reveal>Mindre press ger mer närvaro. Det är hela idén, och det är vad du sätter ditt namn på.</p>
    <div class="mx-auto mt-14 grid max-w-5xl gap-4 md:grid-cols-3 md:gap-6" data-reveal>
      <div class="p-card p-6">
        <p class="p-eyebrow">Din verksamhet</p>
        <p class="mt-3 font-semibold">Den leder tillbaka till dig.</p>
        <p class="p-body mt-2 text-base">Andningen är det dina gäster minns bäst från en klass, och det de har svårast att göra hemma. WeHale är det som händer mellan klasserna: fem minuter på tunnelbanan, tio före sömnen. Den ersätter inte salen. Den bygger vanan som tar gästen tillbaka dit.</p>
      </div>
      <div class="p-card p-6">
        <p class="p-eyebrow">Ditt namn</p>
        <p class="mt-3 font-semibold">Innehåll du kan stå för i salen.</p>
        <p class="p-body mt-2 text-base">Andning som lärs ut som andning, för lugn, fokus och sömn, i ett tempo man kan följa. Byggd med lärare, med samma omsorg som en bra klass. Inga löften om mätvärden eller botemedel som du sedan får förklara för en gäst.</p>
      </div>
      <div class="p-card p-6">
        <p class="p-eyebrow">Dina gäster</p>
        <p class="mt-3 font-semibold">Behandlas som vuxna.</p>
        <p class="p-body mt-2 text-base">Inget förvalt, inget dolt. En påminnelse innan något kostar och avbryt i appen med två tryck. Din rekommendation ska aldrig kosta dig förtroende, för det är ditt förtroende gästen lånar oss.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─── Content ─── -->
<section class="mx-auto max-w-6xl px-6 py-20 md:py-24" id="innehall">
  <p class="p-eyebrow" data-reveal>Innehållet</p>
  <h2 class="p-h2 mt-4 max-w-2xl" data-reveal>Sessioner man kommer tillbaka till.</h2>
  <p class="p-body mt-6 max-w-2xl" data-reveal>Varje session är skriven och inläst av människor som undervisar andning, för ett tillfälle och ett behov: morgonen, lunchrasten, kvällen, natten. Det är omsorgen i inspelningen som gör att man kommer tillbaka, och det är den användarna skriver om.</p>
  <div class="mt-10 grid gap-4 md:grid-cols-2" data-reveal>
    <figure class="p-card p-6">
      <p class="text-[var(--color-gold)]" aria-label="Fem av fem stjärnor">★★★★★</p>
      <blockquote class="mt-3 text-lg leading-relaxed">"I tried meditation apps for years. WeHale is the first one I keep coming back to."</blockquote>
      <figcaption class="mt-4 text-sm text-[var(--color-text-tertiary)]">App Store-recension</figcaption>
    </figure>
    <figure class="p-card p-6">
      <p class="text-[var(--color-gold)]" aria-label="Fem av fem stjärnor">★★★★★</p>
      <blockquote class="mt-3 text-lg leading-relaxed">"Good app for stress management, I like that there are different sessions depending on what outcome you're after."</blockquote>
      <figcaption class="mt-4 text-sm text-[var(--color-text-tertiary)]">App Store-recension</figcaption>
    </figure>
  </div>
  <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4" data-reveal>
    {covers.map((c) => (
      <figure class="relative aspect-[3/4] overflow-hidden rounded-[var(--radius-md)] md:rounded-[var(--radius-lg)]">
        <img src={c.src} alt={c.title} class="h-full w-full object-cover" loading="lazy" />
        <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-3 md:p-4">
          <p class="text-sm font-semibold md:text-base">{c.title}</p>
          <p class="text-xs text-white/70">{c.meta}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<!-- ─── Try it yourself ─── -->
<section class="border-y border-[var(--color-line)] bg-[var(--color-bg-alt)]" id="prova">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 md:grid-cols-[1.2fr_1fr] md:py-24">
    <div>
      <p class="p-eyebrow" data-reveal>Prova själv, innan vi pratar affär</p>
      <h2 class="p-h2 mt-4" data-reveal>WeHale Pro för alltid. För dig, personligen.</h2>
      <p class="p-body mt-6" data-reveal>
        <span class="hidden md:inline">Skanna med telefonen. </span><span class="md:hidden">Tryck på knappen. </span>Koden är din, går att använda en gång och har inget slutdatum. Undervisar fler hos dig? Teamkoden ger alla {p.teamCodeDays} dagar. Och gillar du appen kan du ge bort den till dina gäster också, det är ett av sätten nedan.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center" data-reveal>
        <div class="md:hidden"><a href={codeLink(p.ownerCode)} class="p-btn w-full sm:w-auto">Öppna WeHale med min kod</a></div>
        <a href={APP_STORE_URL} target="_blank" rel="noreferrer noopener" class="p-btn-ghost whitespace-nowrap">Ladda ner på App Store</a>
      </div>
      <p class="mt-4 text-sm text-[var(--color-text-tertiary)]" data-reveal>Android är i beta på Google Play, {p.ourContactName} skickar länken.</p>
    </div>
    <div class="flex flex-col items-start gap-6 md:items-center" data-reveal>
      <div class="hidden flex-col items-center md:flex">
        <OwnerQr code={p.ownerCode} />
        <p class="mt-3 text-sm text-[var(--color-text-secondary)]">Skanna för livstid · en gång · {p.ownerCode}</p>
      </div>
      <div class="p-card w-full p-5 md:max-w-xs">
        <p class="text-xs uppercase tracking-[0.12em] text-[var(--color-text-tertiary)]">Teamkod · {p.teamCodeDays} dagar</p>
        <p class="mt-2 inline-block rounded-[var(--radius-sm)] border border-[var(--color-accent-line)] bg-[var(--color-accent-soft)] px-4 py-2 text-lg font-extrabold tracking-[0.08em] text-[var(--color-accent)]">{p.teamCode}</p>
        <p class="mt-3 text-sm text-[var(--color-text-tertiary)]">Skriv den när kontot skapas. Inget kort behövs.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─── The ways to work together ─── -->
<section class="mx-auto max-w-6xl px-6 py-20 md:py-24" id="modeller">
  <p class="p-eyebrow" data-reveal>{p.models.length === 3 ? "Tre sätt att samarbeta" : p.models.length === 2 ? "Två sätt att samarbeta" : "Så här kan vi samarbeta"}</p>
  <h2 class="p-h2 mt-4 max-w-2xl" data-reveal>Ett samarbete, i den form som passar din verksamhet.</h2>
  <p class="p-body mt-6 max-w-2xl" data-reveal>Gemensamt för alla: dina gäster får WeHale i ditt namn, du bestämmer takten, och du kan pausa när du vill. Skillnaden är var värdet landar.</p>
  <div class="mt-10" data-reveal>
    <Models partner={p} generic={generic} />
  </div>
</section>

{has("checkout") && (
  <>
    <!-- ─── In the checkout ─── -->
    <section class="border-y border-[var(--color-line)] bg-[var(--color-bg-alt)]" id="kassa">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 md:grid-cols-2 md:py-24">
        <div>
          <p class="p-eyebrow" data-reveal>Sätt 1 · I din kassa</p>
          <h2 class="p-h2 mt-4" data-reveal>Ditt namn på gåvan. Dina ord om varför.</h2>
          <p class="p-body mt-6" data-reveal>
            En kryssruta efter kort och e-post, inga nya fält. Gästen väljer själv. Kryssar de i får de {p.guestDiscountMonthly} kr av köpet och {p.guestTrialDays} dagar WeHale Pro, och kopplar gåvan till dig, inte till oss.
          </p>
          <ul class="mt-8 grid gap-4" data-reveal>
            <li class="flex gap-4">
              <span class="p-eyebrow mt-1 w-16 shrink-0">Kassan</span>
              <span class="p-body text-base">Två rader under kortfälten. Obockad tills gästen väljer. Två planer att välja mellan när rutan öppnas.</span>
            </li>
            <li class="flex gap-4">
              <span class="p-eyebrow mt-1 w-16 shrink-0">Sheeten</span>
              <span class="p-body text-base">"Vad är WeHale?" öppnar en kort presentation över kassan, och en enda väg tillbaka.</span>
            </li>
            <li class="flex gap-4">
              <span class="p-eyebrow mt-1 w-16 shrink-0">Kvittot</span>
              <span class="p-body text-base">Gåvan är aktiv. En knapp öppnar appen direkt på gästens konto. Ingen kod att skriva.</span>
            </li>
          </ul>
          <p class="mt-8 text-sm text-[var(--color-text-tertiary)]" data-reveal>Testa själv: bocka i rutan, byt plan, öppna "Vad är WeHale?", betala.</p>
        </div>
        <div data-reveal>
          <CheckoutDemo partner={p} />
        </div>
      </div>
    </section>

    <!-- ─── The numbers, checkout ─── -->
    <section class="mx-auto max-w-6xl px-6 py-20 md:py-24" id="rakna">
      <p class="p-eyebrow" data-reveal>Vad det gör för din kassa</p>
      <h2 class="p-h2 mt-4 max-w-2xl" data-reveal>Rabatten som räddar köpet betalar någon annan.</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-3 md:gap-6" data-reveal>
        <div class="p-card p-6">
          <p class="p-num">{p.guestDiscountMonthly} kr</p>
          <p class="mt-2 text-sm font-semibold text-[var(--color-gold)]">av köpet, till gästen</p>
          <p class="p-body mt-2 text-sm">Rabatter som dyker upp i kassan är det starkaste enskilda medlet mot avbrutna köp. Här är din marginal orörd: vi står för hela rabatten.</p>
        </div>
        <div class="p-card p-6">
          <p class="p-num">0 kr</p>
          <p class="mt-2 text-sm font-semibold text-[var(--color-gold)]">kostnad för dig</p>
          <p class="p-body mt-2 text-sm">Vi betalar rabatten, kontot, faktureringen och supporten. Integrationen tar en timme, eller ingen alls.</p>
        </div>
        <div class="p-card p-6">
          <p class="p-num">Fullt pris</p>
          <p class="mt-2 text-sm font-semibold text-[var(--color-gold)]">på varje köp rabatten räddar</p>
          <p class="p-body mt-2 text-sm">Gästen ser {p.guestDiscountMonthly} kr rabatt och slutför köpet. Du får hela beloppet. Skillnaden betalar vi.</p>
        </div>
      </div>
      <div class="mt-16">
        <p class="p-eyebrow" data-reveal>Räkneexemplet · ett antagande, dina siffror</p>
        <h3 class="p-h2 mt-4 max-w-2xl" data-reveal>Fler slutför köpet när kassan visar en rabatt. Rabatten betalar vi.</h3>
        <div class="mt-8" data-reveal>
          <Calculator partner={p} />
        </div>
      </div>
    </section>
  </>
)}

{has("referral") && (
  <section class:list={["border-y border-[var(--color-line)]", has("checkout") ? "bg-[var(--color-bg-alt)]" : ""]} id="rekommendation">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <p class="p-eyebrow" data-reveal>Sätt 2 · Rekommendation med provision</p>
      <h2 class="p-h2 mt-4 max-w-2xl" data-reveal>Du rekommenderar. Vi sköter resten. Du får {p.commissionPercent} % av allt de köper.</h2>
      <p class="p-body mt-6 max-w-2xl" data-reveal>
        Erbjudandet till dina gäster sätter vi ihop per partner, i dag {offer}. De aktiverar det med din länk eller din kod, i ditt namn. Allt de sedan betalar oss i {p.commissionMonths} månader ger dig {p.commissionPercent} %. Räkna på det här, med dina siffror.
      </p>
      <div class="mt-10" data-reveal>
        <ReferralCalculator partner={p} />
      </div>
    </div>
  </section>
)}

{has("gift") && (
  <section class="mx-auto max-w-6xl px-6 py-20 md:py-24" id="gava">
    <div class="grid items-center gap-12 md:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="p-eyebrow" data-reveal>Sätt 3 · Mervärde till dina gäster</p>
        <h2 class="p-h2 mt-4" data-reveal>{p.teamCodeDays} dagar WeHale Pro till dina gäster. I ditt namn.</h2>
        <p class="p-body mt-6" data-reveal>
          Du får en kod och en länk att dela: i klassen, i nyhetsbrevet, på kvittot. Gästen skapar ett konto, skriver koden och ser att {p.name} har valt WeHale för sina gäster. Inga pengar åt något håll, inget att integrera. Vill du mer senare finns de andra sätten.
        </p>
      </div>
      <div class="p-card p-6 md:p-8" data-reveal>
        <p class="text-xs uppercase tracking-[0.12em] text-[var(--color-text-tertiary)]">Så kan gästkoden se ut</p>
        <p class="mt-3 inline-block rounded-[var(--radius-sm)] border border-[var(--color-accent-line)] bg-[var(--color-accent-soft)] px-4 py-2 text-lg font-extrabold tracking-[0.08em] text-[var(--color-accent)]">{guestCodeExample}</p>
        <p class="mt-4 text-sm text-[var(--color-text-secondary)]">Vi skapar den tillsammans, med en rad i ditt namn som gästen ser i appen. En kod per tillfälle om du vill veta vad som gav vad: en för klassen, en för nyhetsbrevet.</p>
      </div>
    </div>
  </section>
)}

<!-- ─── Getting started + the pilot ─── -->
<section class="border-t border-[var(--color-line)] bg-[var(--color-bg-alt)]" id="igang">
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
    <p class="p-eyebrow" data-reveal>Så här kommer vi igång</p>
    <h2 class="p-h2 mt-4 max-w-2xl" data-reveal>{timelineMode === "checkout" ? "En timme. Eller ingen alls." : "En kvart från oss. Resten är ditt tempo."}</h2>
    <div class="mt-12" data-reveal>
      <Timeline partner={p} mode={timelineMode} />
    </div>
  </div>
</section>

<!-- ─── Terms ─── -->
<section class="border-t border-[var(--color-line)]" id="villkor">
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
    <p class="p-eyebrow" data-reveal>Villkoren, i korthet</p>
    <dl class="mt-8 divide-y divide-[var(--color-line)]" data-reveal>
      {terms.map(([k, v]) => (
        <div class="grid gap-1 py-5 md:grid-cols-[14rem_1fr] md:gap-2">
          <dt class="font-semibold">{k}</dt>
          <dd class="text-[var(--color-text-secondary)]">{v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- ─── Next step ─── -->
<section class="relative isolate overflow-hidden" id="nasta">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <img src="/assets/images/sessions/02-coherent-heart.webp" alt="" class="h-full w-full object-cover object-center" loading="lazy" />
    <div class="absolute inset-0 bg-[var(--color-bg)]/70"></div>
  </div>
  <div class="mx-auto max-w-3xl px-6 py-24 text-center md:py-28">
    <p class="p-eyebrow" data-reveal>Nästa steg</p>
    <h2 class="p-h2 mt-4" data-reveal>Femton minuter, och ett färdigt förslag med ditt namn inom två dagar.</h2>
    <p class="p-body mt-6" data-reveal>Berätta hur dina gäster bokar och betalar i dag, så kommer vi tillbaka med exakt hur det skulle se ut hos dig. Sedan bestämmer du.</p>
    <div class="mt-10 flex flex-col items-center gap-4" data-reveal>
      {mailto
        ? <a href={mailto} class="p-btn">Boka 15 minuter med {p.ourContactName}</a>
        : <p class="text-[var(--color-text-secondary)]">Svara på meddelandet du fick länken i, så bokar {p.ourContactName} en tid.</p>}
      <p class="text-sm text-[var(--color-text-tertiary)]">{p.ourContactName} · WeHale · wehale.io</p>
    </div>
  </div>
</section>
