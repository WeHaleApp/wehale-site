<script define:vars={{ HASH }}>
  const cards = document.querySelectorAll("[data-model-cards] [data-select], [data-chapter-nav] [data-select]");
  const chapters = document.querySelectorAll("[data-chapter]");
  const nav = document.querySelector("[data-chapter-nav]");
  const byHash = Object.fromEntries(Object.entries(HASH).map(([k, v]) => [v, k]));
  const select = (key, { scroll = false, push = true } = {}) => {
    if (!document.querySelector(`[data-chapter="${key}"]`)) return;
    chapters.forEach((c) => { const on = c.dataset.chapter === key; if (on && c.hidden) { c.hidden = false; c.style.animation = "none"; void c.offsetWidth; c.style.animation = ""; } else if (!on) c.hidden = true; });
    cards.forEach((b) => b.setAttribute("aria-selected", b.dataset.select === key ? "true" : "false"));
    document.querySelectorAll("[data-interest] [data-model-option]").forEach((o) => { if (o.value === key) o.checked = true; });
    if (push && HASH[key]) history.replaceState(null, "", "#" + HASH[key]);
    if (scroll && nav) window.scrollTo({ top: nav.getBoundingClientRect().top + window.scrollY - 56, behavior: "smooth" });
  };
  cards.forEach((b) => b.addEventListener("click", () => select(b.dataset.select, { scroll: b.closest("[data-model-cards]") != null })));
  const initial = byHash[location.hash.replace("#", "")];
  if (initial) { select(initial, { push: false }); setTimeout(() => nav?.scrollIntoView({ block: "start" }), 50); }
  // The chapter's reveals sit inside hidden sections when the observer first runs: show them on switch.
  chapters.forEach((c) => c.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("is-visible")));
</script>

