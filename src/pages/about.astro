---
/**
 * About: the people, once (the bios used to be shown twice), why breathing, Varberg, say hello, try a session.
 * No placeholder copy and no outcome claims. Studios and teachers get one line (DIRECTION.md §5); /for stays unlisted.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import StoreButtons from "../components/site/StoreButtons.astro";
import OfferLine from "../components/site/OfferLine.astro";
import { BREATHE_URL } from "../components/site/links";

const people = [
  { name: "Edvin", role: "Co-founder · guides The Wake Up and Unravel", bio: "Years of personal breathwork practice and live group sessions. Curates the catalogue and teaches the techniques behind it." },
  { name: "Philip Sigfridsson", role: "Co-founder · guides The Soft Reboot", bio: "Years of breathwork practice and group facilitation. Keeps the product close to the practice as it actually works." },
  { name: "Isak Gustafsson", role: "Co-founder", bio: "Computer science background and ten years at Precis, Sweden's largest media-tech agency, working with global app teams. Builds the app and runs growth." },
];
---

<BaseLayout title="About WeHale" description="The people behind WeHale, a guided breathing app made in Varberg, Sweden." page="about" current="about">

  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <img src="/assets/images/site/forest-dawn-1440.webp" srcset="/assets/images/site/forest-dawn-640.webp 640w, /assets/images/site/forest-dawn-1440.webp 1440w, /assets/images/site/forest-dawn-2560.webp 2560w" sizes="100vw" alt="" width="1440" height="810" class="h-full w-full object-cover object-[50%_60%]" data-parallax fetchpriority="high" decoding="async" />
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-bg)]/70 via-[var(--color-bg)]/55 to-[var(--color-bg)]"></div>
    </div>
    <div class="mx-auto flex min-h-[72svh] max-w-6xl flex-col justify-end px-5 pb-14 pt-40 md:min-h-[70vh] md:px-6 md:pb-24">
      <p class="t-caption hero-in" style="--d:0ms">About</p>
      <h1 class="t-display hero-in mt-4 max-w-3xl" style="--d:120ms">Built from the breath up.</h1>
      <p class="t-body hero-in mt-5 max-w-xl" style="--d:260ms">Three co-founders, two of whom have taught breathing for years, making an app that is calm, plain and honest about what it is.</p>
    </div>
  </section>

  <section class="bg-[var(--color-bg-raised)]">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-6 md:py-24">
      <p class="t-caption" data-reveal>The people</p>
      <h2 class="t-title1 mt-4" data-reveal>The voices you breathe with.</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-3 md:gap-5">
        {people.map((p, i) => (
          <article class="glass p-6 md:p-7" data-reveal style={`--i:${i}`}>
            <h3 class="t-title2">{p.name}</h3>
            <p class="t-caption mt-2">{p.role}</p>
            <p class="t-body mt-4">{p.bio}</p>
          </article>
        ))}
      </div>
      <p class="t-foot mt-6" data-reveal>With Martin Wikfalk as advisor.</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 md:px-6 md:py-24">
    <div class="grid gap-10 md:grid-cols-[1fr_1.2fr] md:gap-16">
      <div>
        <p class="t-caption" data-reveal>Why breathing</p>
        <h2 class="t-title1 mt-4" data-reveal>The breath first, everything else after.</h2>
      </div>
      <div class="grid gap-5" data-reveal>
        <p class="t-body">In WeHale the breath isn't a feature added to something else. Every session is built around one named technique, and the voice, music and pace follow from it.</p>
        <p class="t-body">A few attentive minutes are easier to fit into a day than an hour. The app is there to make those minutes easy to start, and easy to come back to after a break.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16 md:px-6 md:pb-24">
    <div class="grid gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <h2 class="t-title2" data-reveal>Made in Varberg, Sweden.</h2>
        <p class="t-body mt-4 max-w-md" data-reveal>A small team on the west coast, making something for anyone who wants a few quiet minutes in their day.</p>
      </div>
      <div>
        <h2 class="t-title2" data-reveal>Say hello.</h2>
        <p class="t-body mt-4 max-w-md" data-reveal>Press, partnerships, studios and teachers, investors, or just hello. We read everything.</p>
        <p class="mt-4" data-reveal><a href="mailto:hello@wehale.io" class="link tap text-lg">hello@wehale.io</a></p>
      </div>
    </div>
  </section>

  <section class="relative isolate overflow-hidden border-t border-[var(--color-line)]">
    <div class="absolute inset-0 -z-10 flex items-center justify-center" aria-hidden="true">
      <div class="sphere-field aspect-square w-[140%] max-w-[800px] rounded-full opacity-60"></div>
    </div>
    <div class="mx-auto flex max-w-3xl flex-col items-center px-5 py-20 text-center md:py-28">
      <h2 class="t-title1" data-reveal>Hear them for yourself.</h2>
      <p class="t-body mt-4 max-w-md" data-reveal>Six guided minutes, in your browser. Free, no account.</p>
      <div class="mt-8 flex flex-col items-center gap-4" data-reveal>
        <a href={BREATHE_URL} class="btn" data-try data-at="signoff">Try a session</a>
        <StoreButtons class="justify-center" at="signoff" />
        <OfferLine />
      </div>
    </div>
  </section>
</BaseLayout>
