---
/**
 * Home (DIRECTION.md §3): hero → try it here (/breathe) → what WeHale is → belief band → library → reviews →
 * the practice → sign-off. The feeling in order (SITE-GOALS §2): arrive, recognise, trust, invite.
 * The ad-to-site contract: ?h=<hook> puts the ad's line in the headline (src/data/hooks.json), ?v= picks the hero
 * (hero-still: the brand-film still, the default; hero-landscape: a landscape, no person). Both are decided before first paint.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import StoreButtons from "../components/site/StoreButtons.astro";
import OfferLine from "../components/site/OfferLine.astro";
import { BREATHE_URL } from "../components/site/links";
import DATA from "../data/hooks.json";
import SESSIONS from "../data/breathe-sessions.json";

const guideOf = (slug: string) => SESSIONS.sessions.find((s) => s.slug === slug)?.narrator || "Edvin";
const HOOKS = Object.fromEntries(Object.entries(DATA.hooks).map(([k, h]: [string, any]) => [k, { l: h.line_en, sub: String(h.sub_en || "").replace(/\{guide\}/g, guideOf(h.session)) }]));
const HERO = { def: DATA.variants.home.default, ok: Object.keys(DATA.variants.home.options) };

// The three web sessions, by the names /breathe uses; the app's title and category second (the app's categories are
// Activate, Balance and Calm).
const CAT = { "wake-up": "Activate", unravel: "Balance", "soft-reboot": "Calm" };
const web = SESSIONS.sessions.map((s) => ({ ...s, cat: CAT[s.slug] || "" }));
// Real App Store reviews (SE storefront), quoted exactly; checked against the public reviews feed, 29 Sep 2026.
const reviews = [
  { q: "I tried meditation apps for years. WeHale is the first one I keep coming back to.", n: "Dap tse" },
  { q: "Easy to follow. Professional guidance for conscious breathing. Perfect starting point for meditation.", n: "ZIggeztar" },
  { q: "Really nice and clean app, love it!", n: "Viicktorrr" },
];
const ld = {
  "@context": "https://schema.org", "@type": "MobileApplication", name: "WeHale", operatingSystem: "iOS, Android",
  applicationCategory: "HealthAndFitnessApplication", description: "Guided breathing sessions with a voice to follow.",
  url: "https://wehale.io", downloadUrl: ["https://apps.apple.com/app/id6739413667", "https://play.google.com/store/apps/details?id=com.wehale.app"],
  offers: { "@type": "Offer", price: "0", priceCurrency: "SEK" },
  publisher: { "@type": "Organization", name: "Andningsappen Varberg AB", url: "https://wehale.io", email: "hello@wehale.io", logo: { "@type": "ImageObject", url: "https://wehale.io/assets/images/favicon.png" } },
};
---

<BaseLayout title="WeHale · Guided breathing with Edvin and Philip" description="Guided breathing sessions with Edvin and Philip. Try six minutes free in your browser, then keep going in the app on iPhone or Android." page="home" current="home" pathname="/">
  <Fragment slot="head">
    <!-- the hero variant (?v=), decided before first paint; every event carries it as v -->
    <script is:inline define:vars={{ HERO }}>(function(){try{var v=new URLSearchParams(location.search).get("v");document.documentElement.dataset.v=HERO.ok.indexOf(v)>-1?v:HERO.def;}catch(e){document.documentElement.dataset.v=HERO.def;}})();</script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
  </Fragment>

  <!-- ─── Hero: the place, one line, one white action ─── -->
  <section class="relative isolate overflow-hidden" id="top">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <!-- Phone: a top band with the words beneath it. Desktop: the right 60 %, words to its left. -->
      <div class="absolute inset-x-0 top-0 h-[54%] overflow-hidden md:inset-y-0 md:left-[40%] md:h-auto">
        <picture id="heroPic">
          <source media="(max-width: 767px)" srcset="/assets/images/site/hero-eyes-portrait-750.webp" width="750" height="900" />
          <img src="/assets/images/site/hero-eyes-1440.webp" srcset="/assets/images/site/hero-eyes-1080.webp 1080w, /assets/images/site/hero-eyes-1440.webp 1440w, /assets/images/site/hero-eyes-2560.webp 2560w" sizes="60vw"
            alt="" width="1440" height="810" class="h-full w-full object-cover object-[62%_30%]" fetchpriority="high" decoding="async" />
        </picture>
        <script is:inline>(function(){if(document.documentElement.dataset.v!=="hero-landscape")return;var p=document.getElementById("heroPic"),s=p.querySelector("source"),i=p.querySelector("img");
          s.srcset="/assets/images/site/forest-dawn-portrait-750.webp";i.srcset="/assets/images/site/forest-dawn-1080.webp 1080w, /assets/images/site/forest-dawn-1440.webp 1440w, /assets/images/site/forest-dawn-2560.webp 2560w";i.src="/assets/images/site/forest-dawn-1440.webp";i.style.objectPosition="50% 60%";})();</script>
        <div class="absolute inset-y-0 left-0 hidden w-[60%] bg-gradient-to-r from-[var(--color-bg)] via-[var(--color-bg)]/50 to-transparent md:block"></div>
        <div class="absolute inset-x-0 bottom-0 h-[60%] bg-gradient-to-b from-transparent via-[var(--color-bg)]/75 to-[var(--color-bg)] md:hidden"></div>
        <div class="absolute inset-0 bg-[var(--color-bg)]/15"></div>
      </div>
      <div class="absolute inset-x-0 bottom-0 hidden h-1/3 bg-gradient-to-b from-transparent to-[var(--color-bg)] md:block"></div>
    </div>
    <div class="mx-auto flex min-h-[100svh] max-w-6xl flex-col justify-end px-5 pb-24 pt-[46svh] [@media(max-height:700px)]:pt-[34svh] md:min-h-[88vh] md:px-6 md:pb-24 md:pt-40">
      <p class="t-caption hero-in" style="--d:0ms">Guided breathing · iPhone and Android</p>
      <h1 class="t-display hero-in mt-3 max-w-2xl max-[420px]:!text-[2.3rem]" style="--d:120ms" id="heroH">Six minutes. Breathe with Edvin.</h1>
      <p class="t-body hero-in mt-4 max-w-md" style="--d:260ms" id="heroSub">A guided breathing session, free, right here in your browser.</p>
      <script is:inline define:vars={{ HOOKS }}>(function(){try{var h=HOOKS[new URLSearchParams(location.search).get("h")||""];if(!h)return;document.getElementById("heroH").textContent=h.l;if(h.sub)document.getElementById("heroSub").textContent=h.sub;document.documentElement.dataset.hooked="1";}catch(e){}})();</script>
      <div class="hero-in mt-6 flex flex-row flex-wrap items-center gap-3" style="--d:380ms">
        <a href={BREATHE_URL} class="btn" data-try data-at="hero">
          <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5.5v13a1 1 0 0 0 1.5.86l10.2-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>
          Try a session
        </a>
        <a href="#get-the-app" class="btn-quiet" data-get-app data-at="hero">Get the app</a>
      </div>
      <OfferLine class="hero-in mt-4" />
    </div>
  </section>

  <!-- ─── Try it here: the /breathe start screen, previewed ─── -->
  <section class="relative isolate overflow-hidden bg-gradient-to-b from-[var(--color-bg)] via-[#05080f] to-[var(--color-bg)]" id="try">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:grid-cols-2 md:gap-16 md:px-6 md:py-28">
      <div class="order-2 md:order-1">
        <p class="t-caption" data-reveal>Right here, right now</p>
        <h2 class="t-title1 mt-4" data-reveal>Six guided minutes, in your browser.</h2>
        <p class="t-body mt-5 max-w-md" data-reveal>Sound on, and follow the light: it rises as you breathe in. Edvin or Philip guides you. Free, no account.</p>
        <div class="mt-8" data-reveal><a href={BREATHE_URL} class="btn" data-try data-at="try">Begin</a></div>
        <p class="t-foot mt-5 max-w-md" data-reveal>Breathe at your own pace. Stop if you feel dizzy. Not in water or while driving.</p>
      </div>
      <a href={BREATHE_URL} class="order-1 flex justify-center md:order-2" aria-hidden="true" tabindex="-1" data-try data-at="try_sphere">
        <div class="sphere-field flex aspect-square w-[78%] max-w-[420px] items-center justify-center rounded-full">
          <div class="sphere w-[46%]"></div>
        </div>
      </a>
    </div>
  </section>

  <!-- ─── The library: the three sessions you can do right here, by the names /breathe uses ─── -->
  <section class="mx-auto max-w-6xl px-5 py-16 md:px-6 md:py-24" id="sessions">
    <div class="md:flex md:items-end md:justify-between md:gap-12">
      <div>
        <p class="t-caption" data-reveal>Three to start with</p>
        <h2 class="t-title1 mt-4 max-w-xl" data-reveal>Pick one for right now.</h2>
      </div>
      <p class="t-body mt-5 max-w-md md:mt-0" data-reveal>Each is six minutes, free in your browser, and stays free in the app. The app has many more, most five to fifteen minutes.</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-3 md:gap-4">
      {web.map((s, i) => (
        <a href={`${BREATHE_URL}?s=${s.slug}`} class="photo-card group relative block aspect-[4/3] sm:aspect-[3/4]" data-reveal style={`--i:${i}`} data-try data-at={`library_${s.slug}`}>
          <img src={`/assets/images/sessions/graded-${s.slug}-800.webp`} srcset={`/assets/images/sessions/graded-${s.slug}-480.webp 480w, /assets/images/sessions/graded-${s.slug}-800.webp 800w`} sizes="(min-width: 640px) 33vw, 100vw" alt="" width="800" height="1067" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
          <span class="absolute inset-x-0 bottom-0 block bg-gradient-to-t from-black/85 via-black/45 to-transparent p-5 pt-16">
            <span class="block text-[0.6875rem] font-bold uppercase tracking-[0.12em] text-white/80">{s.cat} · 6 min · with {s.narrator}</span>
            <span class="mt-1 block text-xl font-semibold">{s.choice}</span>
            <span class="block text-[15px] text-white/75">{s.title}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ─── Words from people who use it (real App Store reviews; no rating shown yet) ─── -->
  <section class="bg-[var(--color-bg-raised)]" id="reviews">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-6 md:py-24">
      <h2 class="t-title1" data-reveal>In their words.</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-3 md:gap-5">
        {reviews.map((r, i) => (
          <figure class="glass flex flex-col justify-between p-6 md:p-7" data-reveal style={`--i:${i}`}>
            <blockquote class="text-lg leading-snug">“{r.q}”</blockquote>
            <figcaption class="t-foot mt-6">{r.n} · App Store review</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Sign-off ─── -->
  <section class="relative isolate overflow-hidden border-t border-[var(--color-line)]">
    <div class="absolute inset-0 -z-10 flex items-center justify-center" aria-hidden="true">
      <div class="sphere-field aspect-square w-[140%] max-w-[900px] rounded-full opacity-70"></div>
    </div>
    <div class="mx-auto flex max-w-3xl flex-col items-center px-5 py-20 text-center md:py-32">
      <img src="/assets/images/screens/app-home-540.webp" alt="The WeHale app: the Home screen, with the intro course" width="540" height="1169" class="mb-12 w-[180px] rounded-[1.75rem] shadow-[0_30px_80px_rgba(0,0,0,.55)] md:w-[220px]" loading="lazy" decoding="async" data-reveal />
      <h2 class="t-display" data-reveal>Six minutes, right now.</h2>
      <p class="t-body mt-5 max-w-md" data-reveal>Start with one session here, then keep going in the app on iPhone or Android.</p>
      <div class="mt-9 flex flex-col items-center gap-4" data-reveal>
        <a href={BREATHE_URL} class="btn" data-try data-at="signoff">Try a session</a>
        <StoreButtons class="justify-center" at="signoff" />
        <OfferLine />
      </div>
    </div>
  </section>
</BaseLayout>
