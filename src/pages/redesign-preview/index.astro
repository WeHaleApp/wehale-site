---
/**
 * Home, redesign proposal. Real content from the current home page, in the partner pages' language
 * on the app's tokens. Copy that made effect claims is rewritten and carries data-was="<old line>";
 * wording that needs Isak carries data-pending. Toggle "Show copy changes" in the preview bar.
 */
import RedesignLayout from "../../layouts/RedesignLayout.astro";
import StoreButtons from "../../components/redesign/StoreButtons.astro";
import OfferLine from "../../components/redesign/OfferLine.astro";
import { BREATHE_URL } from "../../components/redesign/links";

const sessions = [
  { slug: "01-box-breath", title: "Box Breath", cat: "Balance", min: 8, tech: "Box breathing" },
  { slug: "03-echoes-of-strength", title: "Echoes of Strength", cat: "Activate", min: 9, tech: "Breath of fire" },
  { slug: "05-into-stillness", title: "Into Stillness", cat: "Calm", min: 10, tech: "4-7-8" },
  { slug: "06-nighttime-serenity", title: "Nighttime Serenity", cat: "Calm", min: 9, tech: "Guided relaxation" },
];
const ways = [
  { k: "Activate", t: "For the morning, or before something that needs you awake.", was: "Wake up your energy. Sharpen focus. Start your morning with intention, not caffeine." },
  { k: "Balance", t: "For the middle of the day, between one thing and the next.", was: "Reset your nervous system midday. Find steady ground between the demands." },
  { k: "Calm", t: "For the evening, to slow down and let the day go.", was: "Soften the body, quiet the mind. Prepare for deep rest or simply let the day go." },
];
const reviews = [
  { q: "I tried meditation apps for years. WeHale is the first one I keep coming back to.", n: "Dap tse" },
  { q: "Good app for stress management, I like that there are different sessions depending on what outcome you're after.", n: "Hasses1" },
  { q: "So happy to have found WeHale — professionally guided sessions and a clean, easy to use app.", n: "Philip J." },
];
---

<RedesignLayout title="WeHale · Come back to yourself" description="Guided breathing sessions with a voice to follow. Try one in your browser, then keep going in the app on iPhone or Android.">

  <!-- ─── Hero: the place, one line, one white action ─── -->
  <section class="relative isolate overflow-hidden" id="top">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <!-- The brand film's closed eyes (WH_16x9, 39 s), already on the site as the hero video.
           Phone: a top band with the words beneath it. Desktop: the right 60 %, words to its left. -->
      <div class="absolute inset-x-0 top-0 h-[52%] overflow-hidden md:inset-y-0 md:left-[40%] md:h-auto">
        <img src="/redesign-preview/img/hero-eyes-closed-1920.webp" srcset="/redesign-preview/img/hero-eyes-closed-1920.webp 1920w, /redesign-preview/img/hero-eyes-closed.webp 2560w" sizes="(min-width: 768px) 60vw, 100vw"
          alt="" class="h-full w-full object-cover object-[62%_30%]" fetchpriority="high" />
        <div class="absolute inset-y-0 left-0 hidden w-[60%] bg-gradient-to-r from-[var(--color-bg)] via-[var(--color-bg)]/50 to-transparent md:block"></div>
        <div class="absolute inset-x-0 bottom-0 h-[65%] bg-gradient-to-b from-transparent via-[var(--color-bg)]/75 to-[var(--color-bg)] md:hidden"></div>
        <div class="absolute inset-0 bg-[var(--color-bg)]/15"></div>
      </div>
      <div class="absolute inset-x-0 bottom-0 hidden h-1/3 bg-gradient-to-b from-transparent to-[var(--color-bg)] md:block"></div>
    </div>
    <div class="mx-auto flex min-h-[92svh] max-w-6xl flex-col justify-end px-5 pb-12 pt-[40svh] md:min-h-[88vh] md:px-6 md:pb-24 md:pt-40">
      <p class="t-caption hero-in" style="--d:0ms" data-was="Guided breathwork for iOS">Breathwork · iPhone and Android</p>
      <h1 class="t-display hero-in mt-4 max-w-2xl" style="--d:120ms">Come back to yourself.</h1>
      <p class="t-body hero-in mt-5 max-w-lg" style="--d:260ms" data-was="Audio-guided breathwork sessions to activate your energy, find balance, or settle into calm. Five minutes is enough to feel the shift.">
        Guided breathing sessions for the morning, the middle of the day and the evening. Most take five to fifteen minutes, with a voice to follow.
      </p>
      <div class="hero-in mt-8 flex flex-col gap-3 sm:flex-row sm:items-center" style="--d:380ms">
        <a href={BREATHE_URL} class="btn">
          <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5.5v13a1 1 0 0 0 1.5.86l10.2-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>
          Try a session
        </a>
        <a href="#get-the-app" class="btn-quiet">Get the app</a>
      </div>
      <OfferLine class="hero-in mt-5" />
    </div>
  </section>

  <!-- ─── Try it here: the /breathe start screen, previewed ─── -->
  <section class="relative isolate overflow-hidden bg-gradient-to-b from-[var(--color-bg)] via-[#05080f] to-[var(--color-bg)]" id="try">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:grid-cols-2 md:gap-16 md:px-6 md:py-28">
      <div class="order-2 md:order-1">
        <p class="t-caption" data-reveal>Right here, right now</p>
        <h2 class="t-title1 mt-4" data-reveal>Breathe with Edvin. Six minutes, in your browser.</h2>
        <p class="t-body mt-5 max-w-md" data-reveal>Sound on, follow the light: it rises as you breathe in. Free, no account. When it's done, the same sessions wait in the app.</p>
        <div class="mt-8" data-reveal><a href={BREATHE_URL} class="btn">Begin</a></div>
        <p class="t-foot mt-5 max-w-md" data-reveal>Breathe at your own pace. Stop if you feel dizzy. Not in water or while driving.</p>
      </div>
      <div class="order-1 flex justify-center md:order-2" aria-hidden="true">
        <div class="sphere-field flex aspect-square w-[78%] max-w-[420px] items-center justify-center rounded-full">
          <div class="sphere w-[46%]"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── What WeHale is ─── -->
  <section class="mx-auto max-w-6xl px-5 py-16 md:px-6 md:py-28" id="app">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div>
        <p class="t-caption" data-reveal>What WeHale is</p>
        <h2 class="t-title1 mt-4" data-reveal>An app of guided breathing, made with the care of a good class.</h2>
        <dl class="mt-10 grid gap-7" data-reveal>
          <div>
            <dt class="t-title3">Sessions</dt>
            <dd class="t-body mt-1" data-was="A library of guided sessions across three categories. Five to forty-five minutes. Every one built around a real breathwork technique with intent.">Activate, Balance and Calm. Each one is built on a named technique, such as box breathing or 4-7-8, and guided by voice at a pace you can follow.</dd>
          </div>
          <div>
            <dt class="t-title3">Courses</dt>
            <dd class="t-body mt-1" data-was="Multi-day journeys">A short intro course: one practice a day, with a short lesson before each session. For anyone who has never breathed on purpose.</dd>
          </div>
          <div>
            <dt class="t-title3">Your week</dt>
            <dd class="t-body mt-1" data-was="Track your rhythm without the streak guilt.">A small weekly goal you set yourself. Miss a day and nothing is lost.</dd>
          </div>
        </dl>
      </div>
      <div class="relative mx-auto flex w-full max-w-md items-start justify-center gap-4 md:block" data-reveal>
        <!-- Placeholder captures: to be replaced with the current Home and player (audit B12). -->
        <img src="/assets/images/screens/01-home.webp" alt="WeHale, the Home screen" width="681" height="1480" class="w-[46%] rounded-[1.6rem] shadow-[0_30px_80px_rgba(0,0,0,.55)] md:w-[58%] md:rounded-[2rem]" loading="lazy" />
        <img src="/assets/images/screens/03-player.webp" alt="WeHale, a session playing" width="681" height="1480" class="mt-12 w-[46%] rounded-[1.6rem] shadow-[0_30px_80px_rgba(0,0,0,.55)] md:absolute md:-right-6 md:top-24 md:mt-0 md:w-[54%] md:rounded-[2rem]" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ─── What we believe: photo band ─── -->
  <section class="relative isolate overflow-hidden" id="belief">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <img src="/redesign-preview/img/forest-dawn.webp" alt="" class="h-full w-full object-cover" data-parallax loading="lazy" />
      <div class="absolute inset-0 bg-[var(--color-bg)]/60"></div>
      <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-[var(--color-bg)] to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[var(--color-bg)] to-transparent"></div>
    </div>
    <div class="mx-auto max-w-6xl px-5 py-20 md:px-6 md:py-32">
      <p class="max-w-3xl text-[clamp(1.75rem,4vw,3rem)] font-medium leading-[1.15]" data-reveal>No hype. No lofty promises.<br class="hidden md:inline" /> No guilt when you miss a day.</p>
      <p class="t-body mt-4 max-w-xl" data-reveal>Less pressure leaves more room to be present. That's the whole idea.</p>
      <div class="mt-10 grid gap-4 md:mt-14 md:grid-cols-3 md:gap-5">
        {ways.map((w, i) => (
          <div class="glass p-6 backdrop-blur-sm" data-reveal style={`--i:${i}`}>
            <p class="t-caption">{w.k}</p>
            <p class="mt-3 text-[1.0625rem] leading-snug" data-was={w.was}>{w.t}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── The library ─── -->
  <section class="mx-auto max-w-6xl px-5 py-16 md:px-6 md:py-28" id="sessions">
    <div class="md:flex md:items-end md:justify-between md:gap-12">
      <div>
        <p class="t-caption" data-reveal>From the library</p>
        <h2 class="t-title1 mt-4 max-w-xl" data-reveal data-was="Real sessions. Real techniques.">Sessions you come back to.</h2>
      </div>
      <p class="t-body mt-5 max-w-md md:mt-0" data-reveal data-was="Five to forty-five minutes (elsewhere: five to twenty, 2–15 min)">Written and voiced by people who teach breathing. Most take five to fifteen minutes; a few longer journeys go deeper.</p>
    </div>
    <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
      {sessions.map((s, i) => (
        <figure class="photo-card relative aspect-[3/4]" data-reveal style={`--i:${i}`}>
          <!-- Placeholder covers: to be swapped for the graded "Quiet dusk" set (audit B11). -->
          <img src={`/assets/images/sessions/${s.slug}.webp`} alt="" class="h-full w-full object-cover" loading="lazy" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/45 to-transparent p-4 pt-14">
            <p class="text-[0.6875rem] font-bold uppercase tracking-[0.12em] text-white/70">{s.cat} · {s.min} min</p>
            <p class="mt-1 text-base font-semibold md:text-lg">{s.title}</p>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="t-foot mt-5" data-reveal data-pending="access wording">Three sessions, The Wake Up, Unravel and The Soft Reboot, stay free after the first 14 days.</p>
  </section>

  <!-- ─── Words from people who use it ─── -->
  <section class="bg-[var(--color-bg-raised)]" id="reviews">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-6 md:py-24">
      <div class="md:flex md:items-end md:justify-between">
        <h2 class="t-title1" data-reveal data-was="What people notice.">In their words.</h2>
        <p class="t-foot mt-3 md:mt-0" data-reveal data-pending="show the rating, or leave it out until there are more">5.0 · 8 ratings on the App Store (Sweden)</p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-3 md:gap-5">
        {reviews.map((r, i) => (
          <figure class="glass flex flex-col justify-between p-6 md:p-7" data-reveal style={`--i:${i}`}>
            <blockquote class="text-lg leading-snug">“{r.q}”</blockquote>
            <figcaption class="t-foot mt-6">{r.n} · App Store review</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── About the practice (replaces "Why breathwork?") ─── -->
  <section class="mx-auto max-w-6xl px-5 py-16 md:px-6 md:py-28" id="practice">
    <div class="grid gap-10 md:grid-cols-[1fr_1.2fr] md:gap-16">
      <div>
        <p class="t-caption" data-reveal>The practice</p>
        <h2 class="t-title1 mt-4" data-reveal data-was="Why breathwork? Your breath is the one thing your nervous system responds to immediately. And it's always with you.">Your breath is always with you.</h2>
      </div>
      <ul class="grid gap-6" data-reveal>
        <li class="t-body" data-was="Slow exhale lengthens the parasympathetic response. Heart rate follows breath; anxiety drops in real time.">
          <span class="text-[var(--color-text)]">Slow breathing with a longer exhale</span> is one of the oldest ways people have settled themselves. Many sessions follow it.
        </li>
        <li class="t-body" data-was="Rhythmic breathing improves attention and working memory more reliably than caffeine without the rebound.">
          <span class="text-[var(--color-text)]">Every session names its technique:</span> box breathing, coherent breathing, 4-7-8, breath of fire. You always know what you're doing, and why it's paced the way it is.
        </li>
        <li class="t-body" data-was="Controlled breath holds train tolerance to CO2. A calmer baseline under pressure and better recovery from stress.">
          <span class="text-[var(--color-text)]">Some sessions include breath holds,</span> always optional and always counted for you. Breathe at your own pace and stop if you feel dizzy.
        </li>
        <li class="t-body" data-was="Daily practice as short as five minutes builds compounding nervous-system resilience over weeks.">
          <span class="text-[var(--color-text)]">A few minutes on most days</span> is how most people make it a habit. The app keeps it easy to start again.
        </li>
        <li class="t-foot">Further reading: <a class="link !font-normal" href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5709795/" rel="noopener">Russo et al. (2017), the physiological effects of slow breathing</a>.</li>
      </ul>
    </div>
  </section>

  <!-- ─── Sign-off ─── -->
  <section class="relative isolate overflow-hidden border-t border-[var(--color-line)]">
    <div class="absolute inset-0 -z-10 flex items-center justify-center" aria-hidden="true">
      <div class="sphere-field aspect-square w-[140%] max-w-[900px] rounded-full opacity-70"></div>
    </div>
    <div class="mx-auto flex max-w-3xl flex-col items-center px-5 py-24 text-center md:py-36">
      <h2 class="t-display" data-reveal>Come back to yourself.</h2>
      <p class="t-body mt-5 max-w-md" data-reveal data-was="Five minutes. No equipment. Just you, your breath, and a calmer nervous system on the other side.">A few minutes, nothing to bring. Start with one session here, then keep going in the app.</p>
      <div class="mt-9 flex flex-col items-center gap-4" data-reveal>
        <a href={BREATHE_URL} class="btn">Try a session</a>
        <StoreButtons class="justify-center" />
        <OfferLine />
      </div>
    </div>
  </section>
</RedesignLayout>
