---
/**
 * Investors: footer only (audit: one job for ad traffic). The stale stats row ("launching May 2026", "Founding
 * team 6", "traction published post-launch") is removed rather than guessed; figures are Isak's to add.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "WeHale for Investors";
const description = "WeHale is a guided breathing app for people who don’t meditate. Team, approach and contact.";

const people = [
  { name: "Isak Gustafsson", role: "Co-founder", bio: "Computer science background, ten years scaling digital products at Precis, Sweden’s largest media-tech agency, working with global app teams. Builds the app and runs growth." },
  { name: "Edvin", role: "Co-founder", bio: "Years of personal breathwork practice and live group sessions. Curates the catalogue and teaches the techniques behind it." },
  { name: "Philip Sigfridsson", role: "Co-founder", bio: "Years of breathwork practice and group facilitation. Anchors the product to the practice as it actually works." },
];
const advisor = { name: "Martin Wikfalk", role: "Advisor", bio: "Founded and exited Mindfullnessappen, the original Swedish meditation app. Advises on brand, voice, and retention in the wellness category." };
const points = [
  { t: "Technique-first", b: "Every session is built around one named breathwork technique, and the voice, music and pace follow from it." },
  { t: "Calm, no hype", b: "We don’t promise transformation. The brand reads like the practice itself: warm, grounded, restrained." },
  { t: "Practice and product", b: "Two co-founders who teach breathing, one who has built digital products for ten years, and an advisor who founded and exited Mindfullnessappen." },
];
---

<BaseLayout title={title} description={description} page="investors" ogImage="/assets/images/og/investors.jpg" solidHeader>
  <section class="pb-16 pt-32 md:pb-24 md:pt-44">
    <div class="mx-auto max-w-6xl px-5 md:px-6">
      <p class="t-caption hero-in">Investors</p>
      <h1 class="t-display hero-in mt-4 max-w-3xl" style="--d:120ms">Breathing for people who don’t meditate.</h1>
      <p class="t-body hero-in mt-6 max-w-2xl" style="--d:260ms">WeHale is a guided breathing app on iPhone and Android, made in Varberg, Sweden.</p>
      <div class="hero-in mt-9 flex flex-wrap gap-3" style="--d:380ms">
        <a href="mailto:isak@wehale.io?subject=WeHale: investor intro" class="btn">Email Isak</a>
        <a href="#team" class="btn-quiet">Meet the team</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16 md:px-6 md:pb-24">
    <h2 class="t-title1" data-reveal>What makes us distinct.</h2>
    <div class="mt-10 grid gap-4 md:grid-cols-3 md:gap-5">
      {points.map((p, i) => (
        <article class="glass p-6 md:p-7" data-reveal style={`--i:${i}`}>
          <h3 class="t-title3">{p.t}</h3>
          <p class="t-body mt-3">{p.b}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-[var(--color-bg-raised)]" id="team">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-6 md:py-24">
      <h2 class="t-title1" data-reveal>The team.</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-3 md:gap-5">
        {people.map((p, i) => (
          <article class="glass p-6 md:p-7" data-reveal style={`--i:${i}`}>
            <h3 class="t-title2">{p.name}</h3>
            <p class="t-caption mt-2">{p.role}</p>
            <p class="t-body mt-4">{p.bio}</p>
          </article>
        ))}
      </div>
      <article class="glass mt-4 p-6 md:max-w-xl md:p-7" data-reveal>
        <h3 class="t-title2">{advisor.name}</h3>
        <p class="t-caption mt-2">{advisor.role}</p>
        <p class="t-body mt-4">{advisor.bio}</p>
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-20 text-center md:py-28">
    <h2 class="t-title1" data-reveal>Let’s talk.</h2>
    <p class="t-body mx-auto mt-4 max-w-md" data-reveal>We’re not raising actively, but we’re always glad to meet thoughtful investors who care about the category.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3" data-reveal>
      <a href="mailto:isak@wehale.io?subject=WeHale: investor intro" class="btn">Email Isak directly</a>
      <a href="mailto:hello@wehale.io?subject=WeHale press kit" class="btn-quiet">Request press kit</a>
    </div>
  </section>
</BaseLayout>
