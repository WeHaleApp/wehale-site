---
import BaseLayout from "../layouts/BaseLayout.astro";
import LegalLayout from "../components/LegalLayout.astro";

const title = "Support · WeHale";
const description =
  "Get help with the WeHale app — account, subscriptions, and technical questions. We usually reply within one business day.";
---

<BaseLayout title={title} description={description} solidHeader>
  <LegalLayout heading="Support" effective="July 5, 2026">
    <h2>Contact us</h2>
    <p>
      The fastest way to reach us is email:
      <a href="mailto:support@wehale.io">support@wehale.io</a>. We usually
      reply within one business day.
    </p>

    <h2>Common questions</h2>

    <h3>How do I manage or cancel my subscription?</h3>
    <p>
      Subscriptions are handled by Apple. Open <strong>Settings</strong> on
      your iPhone → tap your name → <strong>Subscriptions</strong> →
      <strong>WeHale</strong>. There you can change plan, cancel, or restore.
      Cancelling keeps your access until the end of the paid period.
    </p>

    <h3>How do I restore a previous purchase?</h3>
    <p>
      In the WeHale app, go to <strong>Profile → Settings → Restore
      Purchases</strong>. Make sure you're signed in with the same Apple ID
      you used for the original purchase.
    </p>

    <h3>The audio won't play — what do I do?</h3>
    <p>
      Check that your device isn't in silent mode and that the volume is up.
      If a session still won't load, close and reopen the app — sessions are
      streamed and a brief connection drop can interrupt loading. Downloaded
      sessions in your Library play offline.
    </p>

    <h3>How do I delete my account and data?</h3>
    <p>
      In the app: <strong>Profile → Settings → Delete account</strong>. This
      permanently removes your account and associated data. You can also
      email us and we'll handle it for you. See our
      <a href="/privacy">privacy policy</a> for details on what we store.
    </p>

    <h3>Is WeHale a medical product?</h3>
    <p>
      No. WeHale offers guided breathing exercises for general wellbeing. It
      is not a medical device and does not diagnose, treat, or cure any
      condition. If you have a health concern, talk to a healthcare
      professional.
    </p>

    <h2>Feedback</h2>
    <p>
      Found a bug, or have an idea that would make WeHale better? We read
      everything: <a href="mailto:support@wehale.io">support@wehale.io</a>.
    </p>
  </LegalLayout>
</BaseLayout>
