---
/**
 * wehale.io/<route> (today /recharge; the route is DATA.route): the campaign landing page. CONFIDENTIAL until launch (docs/recharge/README.md).
 * One "get the app" page (Isak, 29 Sep: the campaign session lives only in the app), on the app's ink design (7 Oct): the ink
 * bloom (the campaign's ink_long loop, with its still poster) as the ground, the co-brand lockup, the words, the offer, one lilac
 * pill ("Start in the app": an AppsFlyer OneLink carrying the code; on a desktop a QR code of the same link instead).
 * Everything that changes is in src/data/recharge.json: the gate, the session's name, the copy, the code.
 * The gate is the server's (netlify/edge-functions/recharge-gate.ts): the page and its files are not sent without the password.
 */
import BreatheLayout from "../layouts/BreatheLayout.astro";
import "../styles/breathe.css";
import "../styles/recharge.css";
import DATA from "../data/recharge.json";
import { campaignLink } from "../scripts/recharge/link.js";
import fs from "node:fs";

// one config value sets the path (src/data/recharge.json: route)
// and the Swedish draft sits at <route>/sv (same code, same link)
export function getStaticPaths() { return [{ params: { campaign: DATA.route }, props: { lang: "en" } }, { params: { campaign: DATA.route + "/sv" }, props: { lang: "sv" } }]; }

const { lang } = Astro.props;
const S = DATA.session, P = DATA.partner_logo;
const T = lang === "sv" ? { ...DATA.copy, ...DATA.copy_sv } : DATA.copy;
const INAPP = lang === "sv" ? { ...DATA.inapp, ...DATA.inapp_sv } : DATA.inapp;
// the partner's real logo only where it exists locally (gitignored); everywhere else the committed placeholder
const LOCAL = fs.existsSync("public" + P.local) && fs.existsSync("public" + P.local_dark);
const L = LOCAL ? { ...P, src: P.local, src_dark: P.local_dark, width: P.local_width, height: P.local_height } : P;
const HERO = fs.existsSync("public" + DATA.hero.src);   // the photo ground, only where the file exists (never in git)
const SHOTS = HERO && ["home", "player", "afterglow"].every((n) => fs.existsSync(`public/recharge/app-${n}.webp`));
const M = lang === "sv" ? { ...DATA.more, ...DATA.more_sv } : DATA.more;
const HERO_FILM = HERO && fs.existsSync("public" + DATA.hero.film);
// the partner's name: the PARTNER_NAME build variable (Netlify, not secret) wins over the repo value, so the public repo never has to carry it
const made = String(T.made_with || "").replace(/\{partner\}/g, process.env.PARTNER_NAME || DATA.partner_name);
const fill = (t) => String(t || "").replace(/\{minutes\}/g, String(S.minutes)).replace(/\{narrator\}/g, S.narrator);   // the guide and length from the session data
const meta = fill(T.session_line);   // "With {narrator} · {minutes} min"
// the button works before the script runs: the default link (the app sets this visit's own channel and code on top)
const fallback = campaignLink(DATA, { ch: "web", code: DATA.code.default, at: "offer" }) || "#";
---

<BreatheLayout lang={lang} title={`${T.title} · WeHale`} description={`${T.line.split("|").join(" ")} ${T.offer_1}`} hidden themeColor="#050814">
  <Fragment slot="head">
    <style is:inline>html{background:#050814}</style>
    <link rel="preload" as="image" href={HERO ? DATA.hero.src : "/recharge/ink-poster.webp"} type="image/webp" fetchpriority="high" />
  </Fragment>

  <!-- the ground: the campaign's ink bloom. The still poster is the first paint, the Reduce Motion picture and the fallback; the loop
       is added after the page has loaded (never for Reduce Motion or Save-Data) and fades in over it. Fixed, so nothing here can move the words. -->
  <div class={HERO ? "rc-ink rc-photo" : "rc-ink"} aria-hidden="true">
    {HERO ? <Fragment><img class="rc-poster" src={DATA.hero.src} alt="" width="1080" height="1920" decoding="async" fetchpriority="high" style={`--focus:${DATA.hero.focus}`} />{HERO_FILM && <video class="rc-loop" muted loop playsinline preload="none" data-src={DATA.hero.film} tabindex="-1"></video>}</Fragment> : <Fragment>
    <img class="rc-poster" src="/recharge/ink-poster.webp" alt="" width="540" height="958" decoding="async" fetchpriority="high" />
    <video class="rc-loop" muted loop playsinline preload="none" data-src="/recharge/ink-long.mp4" tabindex="-1"></video></Fragment>}
    <div class="rc-veil"></div>
  </div>

  <main class="rc-page" id="rcMain" aria-labelledby="rcH">
    <div class="rc-lockup" aria-label={`WeHale × ${L.alt}`}>
      <img class="rc-we" src={L.wehale_src_dark} alt="WeHale" width="96" height="20" />
      <span class="rc-pair"><i aria-hidden="true">×</i>
      {LOCAL ? <img class="rc-partner" src={L.src_dark} alt={L.alt} width={L.width} height={L.height} /> : <span class="rc-partner-word">PARTNER</span>}</span>
    </div>
    <div class="rc-body">
      <h1 id="rcH">{T.title}</h1>
      <p class="rc-line">{T.line.split("|").map((b) => <span class="rc-beat">{b}</span>)}</p>
      {meta && <p class="rc-only">{meta}</p>}
      <p class="rc-deal">{T.offer_1}</p>
      {made && <p class="rc-made">{made}</p>}
      <p class="rc-how rc-how-m">{T.offer_how}</p>
      <p class="rc-how rc-how-d">{T.offer_how_desktop}</p>
      <a class="rc-btn" id="ctaBtn" href={fallback} rel="noopener noreferrer" referrerpolicy="no-referrer">{T.cta}</a>
      <div class="rc-inapp" id="inApp" data-on={INAPP.on ? "1" : "0"} data-text={INAPP.text} data-copied={INAPP.copied} hidden>
        <p id="inAppText"></p><button type="button" id="inAppCopy">{INAPP.copy}</button>
      </div>
      <figure class="rc-qr" id="qrBox">
        <div class="rc-qrcode" id="qrCode" role="img" aria-label="QR code for the app link"></div>
        <figcaption class="rc-scan"><b>{T.scan_title}</b><span>{T.scan}</span></figcaption>
      </figure>
      <p class="rc-fine"><span>{T.trial}</span> <span class="rc-legal"><a href="/privacy">{T.privacy}</a></span></p>
    </div>
  </main>

  {HERO && (
    <section class="rc-more" aria-labelledby="rcMoreH">
      <div class="rc-more-in">
        <div class="rc-more-copy">
          <p class="rc-eyebrow">{M.eyebrow}</p>
          <h2 id="rcMoreH">{M.title}</h2>
          <p class="rc-more-text">{M.text}</p>
          <ol class="rc-steps">{M.steps.map(([h, t], i) => <li><span class="rc-n" aria-hidden="true">{i + 1}</span><div><b>{h}</b><span>{t}</span></div></li>)}</ol>
          <a class="rc-btn rc-btn2" id="ctaBtn2" href={fallback} rel="noopener noreferrer" referrerpolicy="no-referrer">{T.cta}</a>
          <a class="rc-up" href="#rcMain">{M.again}</a>
        </div>
        {SHOTS && (
          <div class="rc-shots">
            {["home", "player", "afterglow"].map((n) => <figure class={`rc-shot rc-shot-${n}`}><img src={`/recharge/app-${n}.webp`} alt={M["alt_" + n]} width="540" height="1174" loading="lazy" decoding="async" /><figcaption>{M["shot_" + n]}</figcaption></figure>)}
          </div>
        )}
      </div>
    </section>
  )}

  <noscript><p class="noscript">{T.noscript}</p></noscript>
  <script>
    import "../scripts/recharge/app.js";
  </script>
</BreatheLayout>
