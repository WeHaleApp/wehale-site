---
/**
 * BreatheLayout: the full-screen web session (wehale.io/breathe).
 *
 * Deliberately NOT BaseLayout: no site header or footer (the page is a player) and no Tailwind. It shares the site's
 * consent (Consent Mode v2 denied by default, the same compact bar; Begin lifts above it, and it hides during the session)
 * and its tags (src/scripts/tags.js: GTM and the pixels load only after consent, from env vars, docs/ENV.md).
 */
import ConsentBanner from "../components/site/ConsentBanner.astro";
import { consentHead } from "../scripts/consent.js";
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  lang?: string;
  /** A page that must not be found (the gated campaign page): noindex, no canonical, no share tags, no referrer. */
  hidden?: boolean;
  themeColor?: string;
}
const { title, description, ogImage = "/breathe/og.jpg", lang = "en", hidden = false, themeColor = "#0e0907" } = Astro.props;
const canonical = "https://wehale.io/breathe";
const fullOg = ogImage.startsWith("http") ? ogImage : `https://wehale.io${ogImage}`;
const server = { meta: !!(process.env.META_CAPI_TOKEN && process.env.META_PIXEL_ID), tiktok: !!(process.env.TIKTOK_EVENTS_TOKEN && process.env.TIKTOK_PIXEL_ID) };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={themeColor} />
    <meta name="format-detection" content="telephone=no" />
    <script is:inline set:html={consentHead} />
    <script is:inline set:html={`window.__WH_SERVER=${JSON.stringify(server)};`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {hidden && <meta name="robots" content="noindex, nofollow, noarchive" />}
    {hidden && <meta name="referrer" content="same-origin" />}
    <slot name="head" />
    {!hidden && <Fragment>
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={fullOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A warm light breathing in a dark room" />
    <meta property="og:site_name" content="WeHale" />
    <meta name="twitter:card" content="summary_large_image" />
    </Fragment>}
    <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/images/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/images/favicon.png" />
    <link rel="preload" as="image" href="/assets/images/logo.svg" fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href="/breathe/fonts/nunito-sans-500.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/breathe/fonts/nunito-sans-700.woff2" crossorigin />
  </head>
  <body>
    <slot />
    <ConsentBanner tone="warm" />
  </body>
</html>
