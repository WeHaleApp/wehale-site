---
/**
 * BreatheLayout: the full-screen web session (wehale.io/breathe).
 *
 * Deliberately NOT BaseLayout: no site header or footer (the page is a player), no Tailwind, and no Google Tag
 * Manager. GTM-NCPSJ2QF loads on every other page without consent; that is being raised with Isak and the owner
 * of main, and this page does not add to it. Measurement here is consent-first (src/scripts/breathe/measure.js).
 */
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  lang?: string;
}
const { title, description, ogImage = "/breathe/og.jpg", lang = "en" } = Astro.props;
const canonical = "https://wehale.io/breathe";
const fullOg = ogImage.startsWith("http") ? ogImage : `https://wehale.io${ogImage}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e0907" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={fullOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A warm light breathing in a dark room" />
    <meta property="og:site_name" content="WeHale" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/images/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/images/favicon.png" />
    <link rel="preload" as="font" type="font/woff2" href="/breathe/fonts/nunito-sans-500.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/breathe/fonts/nunito-sans-700.woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
