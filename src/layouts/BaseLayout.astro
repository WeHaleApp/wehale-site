---
/**
 * Base layout for every page except /breathe (BreatheLayout, a full-screen player).
 * The design system (src/styles/site.css: the app's tokens, Nunito Sans), the head (canonical without .html, OG),
 * Consent Mode v2 set to denied before anything else, the header, the footer, the consent banner and the "Get the app"
 * sheet. No tag loads here: GTM and the pixels load only after consent (src/scripts/tags.js), from env vars (docs/ENV.md).
 */
import "../styles/site.css";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import ConsentBanner from "../components/site/ConsentBanner.astro";
import GetApp from "../components/site/GetApp.astro";
import { consentHead } from "../scripts/consent.js";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** The canonical path, e.g. "/about". Defaults to the current path without ".html". */
  pathname?: string;
  current?: "home" | "sessions" | "about" | "support";
  /** A short page name for events (home, about, support, 404, …). */
  page?: string;
  /** Pages without a photo hero get a solid header from the start. */
  solidHeader?: boolean;
  noindex?: boolean;
}
const { title, description, ogImage = "/assets/images/og/legal.jpg", pathname, current, page = "page", solidHeader = false, noindex = false } = Astro.props;

const path = (pathname ?? Astro.url.pathname).replace(/\.html$/, "").replace(/\/index$/, "/").replace(/(.)\/$/, "$1") || "/";
const canonical = `https://wehale.io${path === "/" ? "/" : path}`;
const fullOg = ogImage.startsWith("http") ? ogImage : `https://wehale.io${ogImage}`;
// The server copies of the pixels switch on only when their secrets exist at build time. Only booleans reach the page.
const server = { meta: !!(process.env.META_CAPI_TOKEN && process.env.META_PIXEL_ID), tiktok: !!(process.env.TIKTOK_EVENTS_TOKEN && process.env.TIKTOK_PIXEL_ID) };
---

<!doctype html>
<html lang="en" data-page={page} data-solid-header={solidHeader ? "true" : "false"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#090f1d" />
    <!-- Google Consent Mode v2: everything denied by default, before any tag (none loads without consent) -->
    <script is:inline>try{if(!matchMedia("(prefers-reduced-motion: reduce)").matches)document.documentElement.classList.add("motion");}catch(e){}</script>
    <script is:inline set:html={consentHead} />
    <script is:inline set:html={`window.__WH_SERVER=${JSON.stringify(server)};`} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={fullOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="WeHale: guided breathing sessions" />
    <meta property="og:site_name" content="WeHale" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOg} />

    <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/images/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Nunito Sans, self-hosted (one variable file): no third-party font request -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/nunito-sans-var.woff2" crossorigin />
    <slot name="head" />
  </head>

  <body class="bg-[var(--color-bg)] text-[var(--color-text)] antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main"><slot /></main>
    <Footer />
    <GetApp />
    <ConsentBanner />
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
